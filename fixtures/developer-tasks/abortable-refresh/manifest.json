          "{repo_root}/node_modules/typescript/bin/tsc",
          "--project",
          "tsconfig.json"
        ]
      },
      {
        "id": "test",
        "argv": [
          "node",
          "--test",
          "--test-reporter=tap",
          "tests/refresh.test.mjs"
        ]
      }
    ],
    "diagnostic": [
      {
        "id": "compile",
        "argv": [
          "node",
          "{repo_root}/node_modules/typescript/bin/tsc",
          "--project",
          "tsconfig.json"
        ]
      },
      {
        "id": "test",
        "argv": [
          "node",
          "--test",
          "--test-reporter=tap",
          "tests/refresh.test.mjs"
        ]
      }
    ]
  },
  "expected_initial_failure": {
    "command_id": "test",
    "exit_code": "nonzero",
