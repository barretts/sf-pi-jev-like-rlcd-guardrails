+    expect(files).toEqual([...files].sort());
+    expect(files).toHaveLength(new Set(files).size);
+    expect(files).toEqual(expect.arrayContaining([...JEV_RISK_BASELINE_FILES]));
+    expect(files.length).toBeGreaterThan(JEV_RISK_BASELINE_FILES.length);
+    expect(identity).toEqual(getJevRiskBaselineIdentity());
+  });
+
+  it("includes every literal runtime local import in the source closure", () => {
+    const sources = calculateJevRiskBaselineIdentity().sources;
+    for (const file of Object.keys(sources).filter((name) => name.endsWith(".ts"))) {
+      const ast = ts.createSourceFile(
+        file,
+        readFileSync(path.join(root, file), "utf8"),
+        ts.ScriptTarget.Latest,
+        true,
+      );
+      const imports: string[] = [];
+      for (const statement of ast.statements) {
+        if (
+          (ts.isImportDeclaration(statement) || ts.isExportDeclaration(statement)) &&
+          !(ts.isExportDeclaration(statement) && statement.isTypeOnly) &&
+          !(ts.isImportDeclaration(statement) && statement.importClause?.isTypeOnly) &&
+          statement.moduleSpecifier &&
+          ts.isStringLiteral(statement.moduleSpecifier)
+        )
+          imports.push(statement.moduleSpecifier.text);
+      }
+      const visit = (node: ts.Node): void => {
+        if (
+          ts.isCallExpression(node) &&
+          node.expression.kind === ts.SyntaxKind.ImportKeyword &&
+          node.arguments[0] &&
+          ts.isStringLiteral(node.arguments[0])
+        )
+          imports.push(node.arguments[0].text);
+        if (
+          ts.isCallExpression(node) &&
+          ts.isIdentifier(node.expression) &&
+          node.expression.text === "require" &&
+          node.arguments[0] &&
+          ts.isStringLiteral(node.arguments[0])
+        )
+          imports.push(node.arguments[0].text);
+        ts.forEachChild(node, visit);
+      };
+      visit(ast);
+      for (const specifier of imports.filter((name) => name.startsWith("."))) {
+        const dependency = path.posix.normalize(
+          path.posix.join(path.posix.dirname(file), specifier),
+        );
+        expect(sources[dependency], `${file} imports ${specifier}`).toMatch(/^[a-f0-9]{64}$/);
+      }
+    }
+  });
+
+  it("fails closed when a new local import cannot be resolved", () => {
+    expect(() =>
+      calculateJevRiskBaselineIdentity((absolutePath) => {
+        const original = readFileSync(absolutePath);
+        return absolutePath.endsWith("/extensions/sf-guardrail/lib/jev-risk.ts")
+          ? Buffer.concat([original, Buffer.from('\nimport "./missing-risk-helper.ts";\n')])
+          : original;
+      }),
+    ).toThrow(/Missing Jev risk baseline import/);
+  });
+
+  it("adds a newly imported local helper to the identity", () => {
+    const addedFile = "lib/common/runtime-floor.ts";
+    const original = calculateJevRiskBaselineIdentity();
+    expect(original.sources[addedFile]).toBeUndefined();
+    const changed = calculateJevRiskBaselineIdentity((absolutePath) => {
+      const bytes = readFileSync(absolutePath);
+      return absolutePath.endsWith("/extensions/sf-guardrail/lib/jev-risk.ts")
+        ? Buffer.concat([bytes, Buffer.from('\nimport "../../../lib/common/runtime-floor.ts";\n')])
+        : bytes;
+    });
+    expect(changed.sources[addedFile]).toMatch(/^[a-f0-9]{64}$/);
+    expect(changed.sha256).not.toBe(original.sha256);
+  });
+
+  it.each(nativeSources)("invalidates qualification if %s changes", (changedFile) => {
+    const before = calculateJevRiskBaselineIdentity();
+    expect(before.sources[changedFile]).toMatch(/^[a-f0-9]{64}$/);
+    const after = calculateJevRiskBaselineIdentity((absolutePath) => {
+      const original = readFileSync(absolutePath);
+      return absolutePath.endsWith(`/${changedFile}`)
+        ? Buffer.concat([original, Buffer.from("\n// changed implementation\n")])
+        : original;
+    });
+    expect(after.sha256).not.toBe(before.sha256);
+    expect(after.sources[changedFile]).not.toBe(before.sources[changedFile]);
+    for (const file of Object.keys(before.sources).filter((file) => file !== changedFile))
+      expect(after.sources[file]).toBe(before.sources[file]);
+  });
+});
