+    } else throw new Error("Incomplete Jev risk input");
+    if (bytes > JEV_RISK_INPUT_LIMITS.bytes) throw new Error("Jev risk input exceeds byte limit");
+    return current;
+  }
+  const result = visit(value, 0);
+  if (!result || typeof result !== "object" || Array.isArray(result))
+    throw new Error("Incomplete Jev risk input");
+  if (bytes > JEV_RISK_INPUT_LIMITS.bytes) throw new Error("Jev risk input exceeds byte limit");
+  return result as Record<string, unknown>;
+}
+
+function completeToolInput(input: SafetyKernelInput): void {
+  if (FILE_TOOLS.has(input.toolName)) return;
+  const field = isShell(input)
+    ? "command"
+    : input.toolName === "sf_browser_click"
+      ? "ref"
+      : input.toolName === "sf_browser_press"
+        ? "key"
+        : "action";
+  if (typeof input.input[field] !== "string" || !input.input[field].trim())
+    throw new Error(`Incomplete Jev risk input: missing ${field}`);
+}
+
+function completeNativeToolInput(input: SafetyKernelInput): void {
+  const action = input.input.action as string;
+  const requireField = (name: string): void => {
+    const value = input.input[name];
+    if (typeof value !== "string" || !value.trim())
+      throw new Error(`Incomplete Jev risk input: missing ${name} for ${input.toolName} ${action}`);
+  };
+  if (input.toolName === "sf_soql") {
+    if (!SF_SOQL_ACTIONS.has(action))
+      throw new Error(`Incomplete Jev risk input: unknown sf_soql action ${action}`);
+    if (SF_SOQL_QUERY_ACTIONS.has(action)) requireField("query");
+    if (["schema.describe", "schema.relationships", "query.draft"].includes(action))
+      requireField("object");
+    if (action === "schema.search") {
+      const term = input.input.query ?? input.input.object;
+      if (typeof term !== "string" || !term.trim())
+        throw new Error(
+          "Incomplete Jev risk input: missing query or object for sf_soql schema.search",
+        );
+    }
+    if (action === "file.diagnose") requireField("file");
+    if (action === "query.export") requireField("output_file");
+    return;
+  }
+  if (input.toolName === "agentscript_lifecycle") {
+    if (!AGENTSCRIPT_LIFECYCLE_ACTIONS.has(action))
+      throw new Error(`Incomplete Jev risk input: unknown agentscript_lifecycle action ${action}`);
+    if (
+      ["publish", "agent_user_status", "diagnose_agent_user", "provision_agent_user"].includes(
+        action,
+      )
+    )
+      requireField("agent_file");
+    if (["activate", "deactivate", "list_versions"].includes(action))
+      requireField("agent_api_name");
+    return;
+  }
+  if (input.toolName === "slack_canvas") {
+    if (!SLACK_CANVAS_ACTIONS.has(action))
+      throw new Error(`Incomplete Jev risk input: unknown slack_canvas action ${action}`);
+    if (action === "read") {
+      requireField("canvas_id");
+      if (Object.hasOwn(input.input, "criteria")) {
+        const criteria = input.input.criteria;
+        if (!criteria || typeof criteria !== "object" || Array.isArray(criteria))
+          throw new Error("Incomplete Jev risk input: invalid slack_canvas read criteria");
+        const values = criteria as Record<string, unknown>;
+        const contains = values.contains;
+        const containsText = values.contains_text;
+        const sectionTypes = values.section_types;
+        if (
+          (contains !== undefined && typeof contains !== "string") ||
+          (containsText !== undefined && typeof containsText !== "string") ||
+          (sectionTypes !== undefined && !Array.isArray(sectionTypes))
+        )
+          throw new Error("Incomplete Jev risk input: invalid slack_canvas read criteria");
+        const effectiveContains = (
+          (typeof containsText === "string" && containsText) ||
+          (typeof contains === "string" && contains) ||
+          ""
+        ).trim();
+        if (Array.isArray(sectionTypes) && sectionTypes.some((type) => typeof type !== "string"))
+          throw new Error("Incomplete Jev risk input: invalid slack_canvas read criteria");
+        const types = Array.isArray(sectionTypes)
+          ? (sectionTypes as string[]).map((type) => type.trim()).filter(Boolean)
+          : [];
+        if (
+          (!effectiveContains && types.length === 0) ||
+          types.length > 3 ||
+          types.some((type) => !["h1", "h2", "h3", "any_header"].includes(type))
+        )
+          throw new Error("Incomplete Jev risk input: invalid slack_canvas read criteria");
+      }
+    }
+    return;
+  }
+  if (input.toolName === "sf_apex" && !SF_APEX_ACTIONS.has(action))
+    throw new Error(`Incomplete Jev risk input: unknown sf_apex action ${action}`);
+  if (input.toolName === "sf_apex" && action === "test.run") {
+    const targets = ["tests", "class_names", "suite_names"].map((name) => input.input[name]);
+    if (
+      targets.some(
+        (value) =>
+          value !== undefined &&
+          (!Array.isArray(value) ||
+            value.some((entry) => typeof entry !== "string" || !entry.trim())),
+      ) ||
+      !targets.some((value) => Array.isArray(value) && value.length > 0) ||
+      (Array.isArray(targets[2]) &&
+        targets[2].length > 0 &&
+        targets.slice(0, 2).some((value) => Array.isArray(value) && value.length > 0))
+    )
+      throw new Error("Incomplete Jev risk input: invalid targets for sf_apex test.run");
+  }
+  if (input.toolName === "sf_apex" && action === "log.get") requireField("log_id");
+  if (input.toolName === "sf_apex" && action === "diagnose.file") {
+    const file = input.input.file ?? input.input.target;
+    if (typeof file !== "string" || !file.trim())
+      throw new Error(
+        "Incomplete Jev risk input: missing file or target for sf_apex diagnose.file",
+      );
+  }
+  if (input.toolName === "sf_apex" && action === "log.analyze") {
+    const body = input.input.body ?? input.input.file;
+    if (typeof body !== "string" || !body.trim())
+      throw new Error("Incomplete Jev risk input: missing body or file for sf_apex log.analyze");
+  }
+  if (input.toolName === "sf_apex" && input.input.action === "anon.run") {
+    if (typeof input.input.body !== "string" || !input.input.body.trim())
+      throw new Error("Incomplete Jev risk input: missing body for sf_apex anon.run");
+  }
+  if (!input.toolName.startsWith("data360_") || !NATIVE_TOOLS.has(input.toolName)) return;
+
+  const rawParams = input.input.params;
+  if (
+    rawParams !== undefined &&
+    (rawParams === null || typeof rawParams !== "object" || Array.isArray(rawParams))
+  )
+    throw new Error("Incomplete Jev risk input: invalid Data 360 params");
+  const params = rawParams as Record<string, unknown> | undefined;
+  const requireParam = (name: string): void => {
+    const value = params?.[name];
+    if (
+      value === undefined ||
+      value === null ||
+      (typeof value === "string" && !value.trim()) ||
+      (Array.isArray(value) && value.length === 0)
+    )
+      throw new Error(`Incomplete Jev risk input: missing Data 360 ${name} for ${action}`);
+  };
+  const requireStringParam = (name: string): void => {
+    requireParam(name);
+    if (typeof params?.[name] !== "string")
+      throw new Error(`Incomplete Jev risk input: invalid Data 360 ${name} for ${action}`);
+  };
+  if (input.toolName === "data360_api" && action === "rest.request") {
+    for (const name of ["method", "path"]) requireStringParam(name);
+    if (!D360_REST_METHODS.has((params?.method as string).trim().toUpperCase()))
+      throw new Error("Incomplete Jev risk input: unsupported Data 360 REST method");
+    return;
+  }
+  if (action === "action.describe" || action === "examples.get" || action === "catalog.action")
+    requireStringParam("action");
+  if (input.toolName === "data360_discover" && action === "examples.get")
+    requireStringParam("tool");
+  if (
+    ["help", "actions.list", "actions.search", "action.describe", "examples.get"].includes(
+      action,
+    ) ||
+    (input.toolName === "data360_discover" &&
+      ["readiness.probe", "catalog.search", "catalog.action"].includes(action))
+  )
+    return;
+  const mapped = findData360Action(input.toolName as Data360V2ToolName, action);
+  if (!mapped) throw new Error(`Incomplete Jev risk input: unknown Data 360 action ${action}`);
+  for (const name of mapped.requiredParams)
+    if (D360_NON_STRING_REQUIRED_PARAMS.has(name)) requireParam(name);
+    else requireStringParam(name);
+}
+
+/** Org and snapshot observations are resolved independently of old risk labels. */
+export function buildJevRiskInput(input: SafetyKernelInput): JevRiskInput {
+  return buildJevRiskInputFromOrgs(input);
+}
+
+function buildJevRiskInputFromOrgs(
+  input: SafetyKernelInput,
+  resolvedOrgs?: OrgContext[],
+): JevRiskInput {
+  input = { ...input, input: copyInput(input.input) };
+  completeToolInput(input);
+  completeNativeToolInput(input);
+  const facts: JevRiskInput["facts"] = {};
+  if (isShell(input) && typeof input.input.command === "string") {
+    const commands = splitSimpleCommands(input.input.command);
+    // Non-Salesforce shell requests have no Salesforce org. A conservative
+    // default target from the resolver is not an observation about Slack or
+    // other unrelated commands and must not be presented to the model as one.
+    if (commands.some(isSalesforceShellCommand))
+      facts.orgs = commands.map((command, index) => {
+        const org =
+          resolvedOrgs?.[index] ??
+          resolveOrgContext(command, input.cwd, input.config.productionAliases);
+        return { type: org.type, guessed: org.guessed, command };
+      });
+  } else if (
+    input.toolName === "sf_apex" ||
+    input.toolName === "agentscript_lifecycle" ||
+    input.toolName === "sf_soql" ||
+    input.toolName.startsWith("data360_")
+  ) {
+    const org =
+      resolvedOrgs?.[0] ??
+      resolveOrgContextForTarget(
+        typeof input.input.target_org === "string" ? input.input.target_org : undefined,
+        input.cwd,
+        input.config.productionAliases,
+      );
+    facts.orgs = [{ type: org.type, guessed: org.guessed }];
+  }
+  if (input.toolName === "sf_browser_click") {
+    facts.browserRef = browserRefFacts(input);
+    if (
+      facts.browserRef.status === "fresh" &&
+      (!facts.browserRef.label?.trim() || !facts.browserRef.role?.trim())
+    )
+      throw new Error("Incomplete Jev browser facts: fresh reference lacks observed label or role");
+  }
+  if (input.toolName === "sf_browser_press") {
+    const page = browserPageFacts(input);
+    if (!page) throw new Error("Incomplete Jev browser page facts: fresh snapshot unavailable");
+    facts.browserPage = page;
+  }
+  const value = { version: 2 as const, toolName: input.toolName, input: input.input, facts };
+  if (Buffer.byteLength(canonical(value)) > JEV_RISK_INPUT_LIMITS.bytes)
+    throw new Error("Jev risk input exceeds byte limit after host facts");
+  return copyInput(value) as unknown as JevRiskInput;
+}
+
+function browserRefFacts(
+  input: SafetyKernelInput,
+): NonNullable<JevRiskInput["facts"]["browserRef"]> {
+  const lookup = findLatestBrowserSnapshotRefLookup(
+    input.sessionId,
+    typeof input.input.ref === "string" ? input.input.ref : undefined,
+  );
+  return {
+    status: lookup.status === "fresh" ? "fresh" : lookup.status === "stale" ? "stale" : "missing",
+    ...(lookup.ref?.label ? { label: lookup.ref.label } : {}),
+    ...(lookup.ref?.role ? { role: lookup.ref.role } : {}),
+    ...(lookup.ref?.line
+      ? {
+          snapshotSha256: digest({
+            line: lookup.ref.line,
+            capturedAt: lookup.session?.capturedAt ?? null,
+            url: lookup.url ?? null,
+          }),
+        }
+      : {}),
+  };
+}
+
+function browserPageFacts(
+  input: SafetyKernelInput,
+): NonNullable<JevRiskInput["facts"]["browserPage"]> | undefined {
+  const lookup = findLatestBrowserSnapshotPageLookup(input.sessionId);
+  if (lookup.status !== "fresh") return undefined;
+  const session = lookup.session;
+  if (!session?.url || !pin(session.snapshotSha256)) return undefined;
+  let url: URL;
+  try {
+    url = new URL(session.url);
+  } catch {
+    return undefined;
+  }
+  if (
+    !["http:", "https:"].includes(url.protocol) ||
+    url.username ||
+    url.password ||
+    url.origin.length + url.pathname.length > 2048
+  )
+    return undefined;
+  return {
+    status: "fresh",
+    url: `${url.origin}${url.pathname}`,
+    snapshotSha256: session.snapshotSha256,
+  };
+}
+
+function changedBrowserEvidenceDecision(
+  input: SafetyKernelInput,
+  facts: JevRiskInput["facts"]["browserRef"],
+): ClassifiedDecision {
+  const fingerprint = digest({
+    toolName: input.toolName,
+    input: input.input,
+    cwd: input.cwd,
+    sessionId: input.sessionId ?? null,
+    policy: policyJson(input.config),
+    facts: facts ?? null,
+  });
+  return {
+    ruleId: "native-sf-browser-evidence-changed",
+    feature: "nativeToolGate",
+    action: "confirm",
+    reason: "The browser reference became unavailable or changed during risk evaluation.",
+    promptTitle: "⚠ Salesforce browser reference changed",
+    fingerprint,
+    subject: `sf_browser_click ${String(input.input.ref)}`,
+    approvalScope: {
+      fingerprint,
+      label: `Salesforce browser click ${String(input.input.ref)}`,
+      operationFamily: "browser commit",
+      riskTier: "browser_commit_exact",
+      allowSession: false,
+    },
+  };
+}
+
+function isSalesforceShellCommand(command: string): boolean {
+  return salesforceOrgTarget(command).kind === "invocation";
+}
+
+/** Use the same verified lookup path as the Safety Kernel, without its decisions. */
+async function buildJevRiskInputWithLookup(
+  input: SafetyKernelInput,
+): Promise<{ riskInput: JevRiskInput; resolvedOrgs: OrgContext[] }> {
+  input = { ...input, input: copyInput(input.input) };
+  completeToolInput(input);
+  completeNativeToolInput(input);
+  let resolvedOrgs: OrgContext[] = [];
+  const shellCommands =
+    isShell(input) && typeof input.input.command === "string"
+      ? splitSimpleCommands(input.input.command)
+      : undefined;
+  if (shellCommands) {
+    resolvedOrgs = await Promise.all(
+      shellCommands.map(async (command) => {
+        const fast = resolveOrgContext(command, input.cwd, input.config.productionAliases);
+        return fast.guessed && isSalesforceShellCommand(command)
+          ? resolveOrgContextWithLookup(command, input.cwd, input.config.productionAliases)
+          : fast;
+      }),
+    );
+  } else if (
+    input.toolName === "sf_apex" ||
+    input.toolName === "agentscript_lifecycle" ||
+    input.toolName === "sf_soql" ||
+    input.toolName.startsWith("data360_")
+  ) {
+    const targetOrg =
+      typeof input.input.target_org === "string" ? input.input.target_org : undefined;
+    const fast = resolveOrgContextForTarget(targetOrg, input.cwd, input.config.productionAliases);
+    resolvedOrgs = [
+      fast.guessed
+        ? await resolveOrgContextForTargetWithLookup(
+            targetOrg,
+            input.cwd,
+            input.config.productionAliases,
+          )
+        : fast,
+    ];
+  }
+  if (resolvedOrgs.some((org) => org.targetAmbiguous))
+    throw new Error("Jev Salesforce org target is ambiguous; using Safety Kernel fallback");
+  if (resolvedOrgs.some((org) => org.lookupFailed))
+    throw new Error("Jev org lookup failed; using Safety Kernel fallback");
+  if (
+    resolvedOrgs.some(
+      (org, index) =>
+        org.guessed &&
+        (shellCommands ? isSalesforceShellCommand(shellCommands[index] ?? "") : true),
+    )
+  )
+    throw new Error("Jev Salesforce org identity unverified; using Safety Kernel fallback");
+  return { riskInput: buildJevRiskInputFromOrgs(input, resolvedOrgs), resolvedOrgs };
+}
+
+/** Prepare the exact model input used at runtime and by corpus qualification. */
+export async function prepareJevRiskInput(
+  input: SafetyKernelInput,
+  baseline?: ClassifiedDecision,
+): Promise<JevRiskInput> {
+  if (input.toolName === "sf_browser_click") {
+    completeToolInput(input);
+    throw new Error(JEV_BROWSER_CLICK_FALLBACK_REASON);
+  }
+  if (input.toolName === "sf_browser_press") throw new Error(JEV_BROWSER_PRESS_FALLBACK_REASON);
+  const { riskInput, resolvedOrgs } = await buildJevRiskInputWithLookup(input);
+  // Baseline identity is checked for consistency, never copied into model facts.
+  assertOrgFactsAgreeWithBaseline(baseline, resolvedOrgs, riskInput);
+  return riskInput;
+}
+
+function assertOrgFactsAgreeWithBaseline(
+  baseline: ClassifiedDecision | undefined,
+  resolvedOrgs: OrgContext[],
+  riskInput: JevRiskInput,
+): void {
+  if (!baseline?.orgType || baseline.orgResolutionGuessed) return;
+  const index = baseline.orgCommand
+    ? riskInput.facts.orgs?.findIndex((org) => org.command === baseline.orgCommand)
+    : 0;
+  const org = index === undefined || index < 0 ? undefined : resolvedOrgs[index];
+  if (
+    !org ||
+    org.guessed ||
+    org.type !== baseline.orgType ||
+    (baseline.orgAlias !== undefined && org.alias !== baseline.orgAlias) ||
+    (baseline.orgId !== undefined && org.orgId !== baseline.orgId) ||
+    (baseline.orgUsername !== undefined && org.username !== baseline.orgUsername)
+  )
+    throw new Error("Jev org facts disagree with verified Safety Kernel facts");
+}
+
+/** Non-default exact command policy remains authoritative, including off/allow overrides. */
+function customCommandPolicy(config: GuardrailConfig): boolean {
+  const bundled = readBundledConfig();
+  return (
+    canonical(policyJson(config.productionAliases)) !==
+      canonical(policyJson(bundled.productionAliases)) ||
+    canonical(policyJson(config.commandGate)) !== canonical(policyJson(bundled.commandGate)) ||
+    canonical(policyJson(config.orgAwareGate)) !== canonical(policyJson(bundled.orgAwareGate))
+  );
+}
+
+/** Keep explicit execution intent and unavailable browser evidence in the host. */
+function nativeIntentPolicyFloor(input: SafetyKernelInput, baseline?: ClassifiedDecision): boolean {
+  const action = input.input.action;
+  const params = input.input.params;
+  const rawGet =
+    input.toolName === "data360_api" &&
+    action === "rest.request" &&
+    params !== null &&
+    typeof params === "object" &&
+    !Array.isArray(params) &&
+    typeof (params as Record<string, unknown>).method === "string" &&
+    ((params as Record<string, unknown>).method as string).trim().toUpperCase() === "GET";
+  // Anonymous Apex can call org methods with side effects even when its body
+  // has no direct DML signal. Preserve every existing native confirmation.
+  // A raw GET is semantic: its path and response can expose sensitive data.
+  if (baseline?.feature === "nativeToolGate" && !rawGet) return true;
+  if (input.toolName === "agentscript_lifecycle" && action === "provision_agent_user")
+    return input.input.dry_run !== false || baseline?.ruleId === "native-agentscript-lifecycle";
+  if (input.toolName.startsWith("data360_") && NATIVE_TOOLS.has(input.toolName)) {
+    if (input.input.dry_run === true) return true;
+    if (
+      input.input.allow_confirmed === true &&
+      !rawGet &&
+      baseline?.ruleId === "native-data360-confirmed-execute"
+    )
+      return true;
+    // These dispatcher branches only inspect the local action catalog. Other
+    // read-like actions can make org requests or disclose data, so stay eligible.
+    if (
+      baseline === undefined &&
+      (action === "help" ||
+        action === "actions.list" ||
+        action === "actions.search" ||
+        action === "action.describe" ||
+        (input.toolName === "data360_discover" &&
+          (action === "catalog.search" || action === "catalog.action")))
+    )
+      return true;
+  }
+  if (input.toolName === "sf_apex" && input.input.allow_mutation === true)
+    return baseline?.ruleId === "native-sf-apex-anon-run";
+  if (input.toolName === "sf_browser_press") {
+    if (baseline?.ruleId === "native-sf-browser-commit") return true;
+    return (
+      baseline === undefined &&
+      typeof input.input.key === "string" &&
+      /^(escape|esc|tab|shift\+tab)$/i.test(input.input.key.replace(/\s+/g, ""))
+    );
+  }
+  if (input.toolName === "sf_browser_click") {
+    if (baseline?.ruleId === "native-sf-browser-commit") return true;
+    const lookup = findLatestBrowserSnapshotRefLookup(
+      input.sessionId,
+      typeof input.input.ref === "string" ? input.input.ref : undefined,
+    );
+    // The baseline already confirms missing and stale refs. Do not turn an
+    // undefined baseline into an allow if snapshot state changes meanwhile.
+    if (lookup?.status !== "fresh") return false;
+    return (
+      baseline === undefined &&
+      typeof lookup.ref?.label === "string" &&
+      /^(cancel|close|dismiss|back|previous)$/i.test(lookup.ref.label.trim())
+    );
+  }
+  return false;
+}
+export function jevRiskPolicyFloor(
+  input: SafetyKernelInput,
+  baseline?: ClassifiedDecision,
+): boolean {
+  if (
+    FILE_TOOLS.has(input.toolName) ||
+    baseline?.feature === "policies" ||
+    baseline?.orgResolutionSource === "productionAliases" ||
+    baseline?.action === "block" ||
+    baseline?.ruleId === "safe-temp-cleanup" ||
+    baseline?.ruleId === "remote-script-command-substitution" ||
+    nativeIntentPolicyFloor(input, baseline)
+  )
+    return true;
+  if (isShell(input)) {
+    if (customCommandPolicy(input.config)) return true;
+    if (
+      typeof input.input.command === "string" &&
+      evaluateCommand(input.input.command, input.config.commandGate)?.action === "allow"
+    )
+      return true;
+  }
+  return false;
+}
+export function jevRiskEligible(input: SafetyKernelInput): boolean {
+  return isShell(input) || NATIVE_TOOLS.has(input.toolName);
+}
+
+function modelDecision(
+  input: SafetyKernelInput,
+  baseline: ClassifiedDecision | undefined,
+  provider: JevRiskProvider,
+  prediction: Prediction,
+  riskInput: JevRiskInput,
+): ClassifiedDecision {
+  const fingerprint = digest({
+    operation: riskInput,
+    cwd: input.cwd,
+    orgIdentity: baseline?.orgId ?? baseline?.orgUsername ?? baseline?.orgAlias ?? null,
+    baselineImplementationSha256: getJevRiskBaselineSha256(),
+    config: policyJson(input.config),
+    model: provider.modelSha256,
+    protocol: provider.protocolSha256,
+  });
+  const action = prediction.action === "allow" ? "allow" : "confirm";
+  const subject =
+    baseline?.subject ??
+    (isShell(input) && typeof input.input.command === "string"
+      ? input.input.command
+      : `${input.toolName} operation ${prediction.inputSha256.slice(0, 12)}`);
+  return {
+    ...(baseline ?? {}),
+    ruleId: baseline?.ruleId ?? "jev-semantic-risk",
+    feature: baseline?.feature ?? (isShell(input) ? "commandGate" : "nativeToolGate"),
+    action,
+    fingerprint,
+    subject,
+    reason:
+      action === "allow"
+        ? "Jev classified this complete operation as safe without approval."
+        : prediction.action === "abstain"
+          ? "Jev could not confidently classify this operation as safe; approval is required."
+          : (baseline?.reason ??
+            "Jev detected a risky or ambiguous operation; approval is required."),
+    approvalScope:
+      action === "confirm"
+        ? {
+            fingerprint,
+            label: "this exact operation under this Jev model and policy",
+            operationFamily: baseline?.approvalScope?.operationFamily ?? "jev semantic operation",
+            riskTier: baseline?.approvalScope?.riskTier ?? "jev_semantic_exact",
+            allowSession:
+              baseline?.approvalScope?.allowSession === true &&
+              baseline?.orgType !== "production" &&
+              !baseline?.orgResolutionGuessed,
+          }
+        : undefined,
+    risk: {
+      source: "jev",
+      modelSha256: provider.modelSha256,
+      protocolSha256: provider.protocolSha256,
+      inputSha256: prediction.inputSha256,
+      allowScore: prediction.allowScore,
+      elapsedMs: prediction.elapsedMs,
+    },
+  };
+}
+
+export async function evaluateJevRisk(
+  pi: Pick<ExtensionAPI, "events">,
+  input: SafetyKernelInput,
+  baseline: ClassifiedDecision | undefined,
+  options: { mode?: JevRiskMode; signal?: AbortSignal; startedAt?: number } = {},
+): Promise<{ decision?: ClassifiedDecision; comparison?: JevRiskComparison }> {
+  const start = options.startedAt ?? performance.now();
+  let mode: JevRiskMode | "invalid" = "invalid";
+  const comparison: JevRiskComparison = {
+    version: 1,
+    timestamp: Date.now(),
+    mode,
+    toolName: input.toolName,
+    source: "rules_fallback",
+    baseline: baseline?.action ?? "allow",
+    actual: baseline?.action ?? "allow",
+    elapsedMs: 0,
+    reason: "provider_unavailable",
+  };
+  let evaluation: Promise<Prediction> | undefined;
+  let signal: AbortSignal | undefined;
+  let aborted: (() => void) | undefined;
+  const browserClickFallback = (
+    facts: JevRiskInput["facts"]["browserRef"],
+  ): { decision?: ClassifiedDecision; comparison: JevRiskComparison } => {
+    if (baseline === undefined && facts?.status !== "fresh") {
+      comparison.reason = "Browser reference evidence unavailable before model check";
+      comparison.actual = mode === "shadow" ? comparison.baseline : "confirm";
+      return {
+        decision: mode === "shadow" ? baseline : changedBrowserEvidenceDecision(input, facts),
+        comparison,
+      };
+    }
+    comparison.reason = JEV_BROWSER_CLICK_FALLBACK_REASON;
+    return { decision: baseline, comparison };
+  };
+  try {
+    mode = options.mode ?? jevRiskMode();
+    comparison.mode = mode;
+    if (mode === "off") return { decision: baseline };
+    input = { ...input, input: copyInput(input.input) };
+    if (!jevRiskEligible(input) && !FILE_TOOLS.has(input.toolName)) return { decision: baseline };
+    if (input.toolName === "sf_browser_click" && jevRiskPolicyFloor(input, baseline)) {
+      if (baseline === undefined) {
+        const facts = browserRefFacts(input);
+        if (facts.status !== "fresh") return browserClickFallback(facts);
+      }
+      comparison.source = "exact_policy";
+      comparison.reason = "exact_policy_constraint";
+      return { decision: baseline, comparison };
+    }
+    completeToolInput(input);
+    if (input.toolName !== "sf_browser_click" && jevRiskPolicyFloor(input, baseline)) {
+      comparison.source = "exact_policy";
+      comparison.reason = "exact_policy_constraint";
+      return { decision: baseline, comparison };
+    }
+    // Cached browser evidence cannot establish the live page, reference, or
+    // focus when the tool eventually executes.
+    if (input.toolName === "sf_browser_click") {
+      return browserClickFallback(baseline === undefined ? browserRefFacts(input) : undefined);
+    }
+    if (input.toolName === "sf_browser_press") {
+      comparison.reason = JEV_BROWSER_PRESS_FALLBACK_REASON;
+      return { decision: baseline, comparison };
+    }
+    completeNativeToolInput(input);
+    const request: { version: 1; providers: JevRiskProvider[] } = { version: 1, providers: [] };
+    pi.events?.emit(JEV_RISK_PROVIDER_EVENT, request);
+    if (request.providers.length !== 1) throw new Error("Jev risk provider missing or duplicated");
+    const provider = request.providers[0];
+    if (
+      provider.version !== 1 ||
+      provider.id !== "jev" ||
+      !pin(provider.protocolSha256) ||
+      typeof provider.evaluate !== "function"
+    )
+      throw new Error("Invalid Jev risk provider");
+    if (mode === "enforce" && (!provider.qualified || !pin(provider.modelSha256)))
+      throw new Error("Jev risk model is not warmed and qualified");
+    const baselineSha256 = getJevRiskBaselineSha256();
+    if (mode === "enforce" && provider.qualificationBaselineSha256 !== baselineSha256)
+      throw new Error("Jev qualification does not match the installed sf-guardrail baseline");
+    const modelSha256 = provider.modelSha256;
+    const protocolSha256 = provider.protocolSha256;
+    const remaining = JEV_RISK_DEADLINE_MS - (performance.now() - start);
+    if (remaining <= 0) throw new Error("Jev risk preparation exceeded deadline");
+    const timeout = AbortSignal.timeout(Math.max(1, Math.floor(remaining)));
+    signal = options.signal ? AbortSignal.any([options.signal, timeout]) : timeout;
+    signal.throwIfAborted();
+    const abortPromise = new Promise<never>((_resolve, reject) => {
+      aborted = () => reject(signal?.reason);
+      signal?.addEventListener("abort", aborted, { once: true });
+      if (signal?.aborted) aborted();
+    });
+    const riskInput = await Promise.race([prepareJevRiskInput(input, baseline), abortPromise]);
+    signal.throwIfAborted();
+    const inputSha256 = digest(riskInput);
+    if (performance.now() - start > JEV_RISK_DEADLINE_MS)
+      throw new Error("Jev risk preparation exceeded deadline");
+    evaluation = Promise.resolve(provider.evaluate(riskInput, signal));
+    const prediction = await Promise.race([evaluation, abortPromise]);
+    signal.throwIfAborted();
+    if (performance.now() - start > JEV_RISK_DEADLINE_MS)
+      throw new Error("Jev risk evaluation exceeded deadline");
+    if (
+      provider.protocolSha256 !== protocolSha256 ||
+      (modelSha256 !== null && provider.modelSha256 !== modelSha256) ||
+      (mode === "enforce" && provider.qualified !== true)
+    )
+      throw new Error("Jev risk provider identity or qualification changed during evaluation");
+    if (mode === "enforce" && provider.qualificationBaselineSha256 !== baselineSha256)
+      throw new Error("Jev qualification baseline changed during evaluation");
+    if (
+      !["allow", "confirm", "abstain"].includes(prediction?.action) ||
+      prediction.inputSha256 !== inputSha256 ||
+      prediction.calibration !== "uncalibrated" ||
+      !Number.isFinite(prediction.allowScore) ||
+      prediction.allowScore < 0 ||
+      prediction.allowScore > 1 ||
+      !Number.isFinite(prediction.elapsedMs) ||
+      prediction.elapsedMs < 0 ||
+      prediction.elapsedMs > JEV_RISK_DEADLINE_MS ||
+      !Number.isSafeInteger(prediction.inputTokens) ||
+      prediction.inputTokens < 1 ||
+      (prediction.action === "allow" && prediction.allowScore < 0.99) ||
+      !pin(provider.modelSha256) ||
+      !["risk_detected", "low_allow_score", "safe_classification"].includes(prediction.reason)
+    )
+      throw new Error("Invalid, incomplete or late Jev risk prediction");
+    const resolvedModelSha256 = provider.modelSha256;
+    const decision = modelDecision(
+      input,
+      baseline,
+      { ...provider, modelSha256: resolvedModelSha256, protocolSha256 },
+      prediction,
+      riskInput,
+    );
+    signal.throwIfAborted();
+    if (performance.now() - start > JEV_RISK_DEADLINE_MS)
+      throw new Error("Jev risk decision preparation exceeded deadline");
+    Object.assign(comparison, {
+      source: "jev",
+      prediction: prediction.action,
+      actual: decision.action,
+      modelSha256: resolvedModelSha256,
+      protocolSha256,
+      inputSha256,
+      allowScore: prediction.allowScore,
+      reason: prediction.reason,
+    });
+    return { decision: mode === "shadow" ? baseline : decision, comparison };
+  } catch (error) {
+    comparison.reason = errorReason(
+      error,
+      signal?.aborted
+        ? `Jev risk check was aborted or exceeded the ${JEV_RISK_DEADLINE_MS} ms deadline`
+        : "Jev risk evaluation unavailable",
+    );
+    // An explicit operational fallback preserves the existing safety layer.
+    return { decision: baseline, comparison };
+  } finally {
+    comparison.elapsedMs = performance.now() - start;
+    if (aborted && signal) signal.removeEventListener("abort", aborted);
+    void evaluation?.catch(() => {});
+  }
+}
+
+export function renderJevRiskComparisons(ctx: Pick<ExtensionContext, "sessionManager">): string {
+  const records = ctx.sessionManager
+    .getEntries()
+    .filter((entry) => entry.type === "custom" && entry.customType === JEV_RISK_COMPARISON_ENTRY)
+    .slice(-20)
+    .map((entry) => (entry as { data?: JevRiskComparison }).data)
+    .filter(Boolean);
+  return [
+    renderJevRiskStatus(),
+    ...records.map(
+      (row) =>
+        `${row.toolName}: rules=${row.baseline}; Jev=${row.prediction ?? "unavailable"}; source=${row.source}; ${Math.round(row.elapsedMs)} ms; ${row.reason}`,
+    ),
+    ...(records.length ? [] : ["No risk comparisons recorded in this session."]),
+  ].join("\n");
+}
+
+export function renderJevRiskStatus(): string {
+  try {
+    return `Jev risk mode: ${jevRiskMode()}; model scores are uncalibrated. Use /jev-risk status or /jev-risk warmup for the local provider.`;
+  } catch (error) {
+    return `Jev risk mode: invalid; existing rules remain active. ${errorReason(error, "Invalid configuration")}`;
+  }
+}
