+
+function provider(seen: JevRiskInput[], action: "allow" | "confirm" = "confirm"): JevRiskProvider {
+  return {
+    version: 1,
+    id: "jev",
+    protocolSha256: "a".repeat(64),
+    modelSha256: "b".repeat(64),
+    qualified: true,
+    get qualificationBaselineSha256() {
