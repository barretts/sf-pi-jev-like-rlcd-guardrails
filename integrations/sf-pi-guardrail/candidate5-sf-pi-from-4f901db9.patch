+async function harness(
+  providers: JevRiskProvider[] = [],
+  options: { headless?: boolean; pick?: string | undefined } = {},
+) {
+  const recorder = createRuntimeRecorder();
+  const entries: Entry[] = [];
+  const picks: Array<{ choices: string[]; title: string }> = [];
+  Object.assign(recorder.pi, {
+    appendEntry: (customType: string, data: Record<string, unknown>) => {
+      entries.push({ type: "custom", customType, data });
+    },
+  });
+  recorder.pi.events.on(JEV_RISK_PROVIDER_EVENT, (request: { providers: JevRiskProvider[] }) =>
+    request.providers.push(...providers),
+  );
+  sfGuardrail(recorder.pi as unknown as ExtensionAPI);
+  const ctx = {
+    cwd: "/project",
+    hasUI: !options.headless,
+    signal: new AbortController().signal,
+    sessionManager: {
+      getSessionId: () => "guardrail-hook-test",
+      getEntries: () => entries,
+      getBranch: () => [],
+    },
+    ui: {
+      notify: vi.fn(),
+      setStatus: vi.fn(),
+      select: vi.fn(async (title: string, choices: string[]) => {
+        picks.push({ choices, title });
+        return options.pick;
+      }),
+    },
+  } as unknown as ExtensionContext;
+  for (const handler of recorder.handlers.get("session_start") ?? []) await handler({}, ctx);
+  async function call(operation: Operation) {
+    const hook = recorder.handlers.get("tool_call")?.[0];
+    if (!hook) throw new Error("Real guardrail tool_call was not registered");
+    const result = (await hook(operation, ctx)) as { block?: boolean; reason?: string } | undefined;
+    // The stub only records whether Pi would reach execution after this hook.
+    return { accepted: result?.block !== true, reason: result?.reason };
+  }
+  return {
+    ...recorder,
+    entries,
+    picks,
+    ctx,
+    call,
+    decisions: () =>
+      entries
+        .filter((entry) => entry.customType === DECISION_ENTRY_TYPE)
+        .map((entry) => entry.data),
+    comparisons: () =>
+      entries
+        .filter((entry) => entry.customType === JEV_RISK_COMPARISON_ENTRY)
+        .map((entry) => entry.data as unknown as JevRiskComparison),
+  };
+}
