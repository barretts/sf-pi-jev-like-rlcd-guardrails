diff --git a/extensions/sf-browser/tests/page-evidence-invalidation.test.ts b/extensions/sf-browser/tests/page-evidence-invalidation.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a7f87aad0b9b7c300023e7413f818999e1bc35dc
--- /dev/null
+++ b/extensions/sf-browser/tests/page-evidence-invalidation.test.ts
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/** Browser actions use stubbed execution; page evidence and click refs use the real session store. */
+import { randomUUID } from "node:crypto";
+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  findLatestBrowserSnapshotPageLookup,
+  findLatestBrowserSnapshotRefLookup,
+  writeLatestBrowserSnapshotRefs,
+} from "../../../lib/common/sf-browser-snapshot-state.ts";
+import { createRuntimeRecorder } from "../../../scripts/runtime-surface/harness.ts";
+import { readBundledConfig } from "../../sf-guardrail/lib/config.ts";
+import { evaluateJevRisk } from "../../sf-guardrail/lib/jev-risk.ts";
+import { evaluateSafety } from "../../sf-guardrail/lib/safety-kernel.ts";
+import { runAgentBrowser } from "../lib/agent-browser.ts";
+import { runEditorOperation } from "../lib/editor-surfaces.ts";
+import { dismissAmbientOverlays } from "../lib/overlay-dismissal.ts";
+import { registerSfBrowserFillTool } from "../lib/sf_browser_fill-tool.ts";
+import { registerSfBrowserSelectTool } from "../lib/sf_browser_select-tool.ts";
+import { registerSfBrowserWaitTool } from "../lib/sf_browser_wait-tool.ts";
+
+vi.mock("../lib/agent-browser.ts", () => ({ runAgentBrowser: vi.fn() }));
+
+const url = "https://example.my.salesforce.com/lightning/setup/EinsteinPromptStudio/home";
+const snapshot = [
+  '- Iframe "Classic Setup" [ref=e4]',
+  '  - textbox "Name" [ref=e8]',
+  '  - button "Save" [ref=e9]',
+].join("\n");
+const browserResult = (stdout = "") => ({
+  stdout,
+  stderr: "",
+  code: 0,
+  durationMs: 0,
+  durationText: "0 ms",
+});
+
+function session() {
+  const sessionId = `sf-browser-page-only-${randomUUID()}`;
+  writeLatestBrowserSnapshotRefs({ sessionId, snapshot, url });
+  const ctx = {
+    cwd: "/example/project",
+    sessionManager: { getSessionId: () => sessionId },
+  } as unknown as ExtensionContext;
+  return { sessionId, ctx };
+}
+
+type ActionTool = {
+  name: string;
+  execute: (
+    id: string,
+    params: Record<string, unknown>,
+    signal: AbortSignal,
+    onUpdate: undefined,
+    ctx: ExtensionContext,
+  ) => Promise<{ details: Record<string, unknown> }>;
+};
+
+beforeEach(() => vi.mocked(runAgentBrowser).mockReset());
+
+describe("SF Browser page-only evidence invalidation", () => {
+  it.each([
+    ["fill", false],
+    ["fill", true],
+    ["select", false],
+    ["select", true],
+  ] as const)("invalidates press evidence after %s (frame retry: %s)", async (action, retry) => {
+    const { sessionId, ctx } = session();
+    const recorder = createRuntimeRecorder();
+    const pi = recorder.pi as unknown as ExtensionAPI;
+    if (action === "fill") registerSfBrowserFillTool(pi);
+    else registerSfBrowserSelectTool(pi);
+    const tool = (recorder.pi.getAllTools() as ActionTool[]).find(
+      (candidate) => candidate.name === `sf_browser_${action}`,
+    );
+    expect(tool).toBeDefined();
+    const clickInput = {
+      toolName: "sf_browser_click",
+      input: { ref: "@e9", reason: "save" },
+      cwd: ctx.cwd,
+      sessionId,
+      config: readBundledConfig(),
+    };
+    const beforeClick = await evaluateSafety(clickInput);
+    expect(beforeClick?.ruleId).toBe("native-sf-browser-commit");
+    expect(findLatestBrowserSnapshotPageLookup(sessionId).status).toBe("fresh");
+
+    let actionAttempts = 0;
+    vi.mocked(runAgentBrowser).mockImplementation(async (_pi, args) => {
+      if (args?.[0] === action) {
+        expect(findLatestBrowserSnapshotPageLookup(sessionId).status).toBe("stale");
+        actionAttempts += 1;
+        if (retry && actionAttempts === 1) throw new Error("element covered by force-aloha-page");
+      }
+      return browserResult(args?.[0] === "snapshot" ? snapshot : "");
+    });
+    const result = await tool!.execute(
+      "stub-call",
+      action === "fill" ? { ref: "@e8", value: "Draft" } : { ref: "@e8", values: ["Draft"] },
+      new AbortController().signal,
+      undefined,
+      ctx,
+    );
+    expect(result.details).toMatchObject({
+      ok: true,
+      recoveredIframeRef: retry ? "@e4" : undefined,
+    });
+    expect(actionAttempts).toBe(retry ? 2 : 1);
+    expect(findLatestBrowserSnapshotPageLookup(sessionId).status).toBe("stale");
+    expect(findLatestBrowserSnapshotRefLookup(sessionId, "@e9").status).toBe("fresh");
+    const afterClick = await evaluateSafety(clickInput);
+    expect(afterClick?.ruleId).toBe(beforeClick?.ruleId);
+    expect(afterClick?.approvalScope?.detail).toContain("snapshot_status=fresh");
+    expect(afterClick?.approvalScope?.detail).toContain("snapshot_label=Save");
+    expect(
+      (
+        await evaluateJevRisk(
+          recorder.pi as Parameters<typeof evaluateJevRisk>[0],
+          clickInput,
+          beforeClick,
+          {
+            mode: "off",
+          },
+        )
+      ).decision,
+    ).toBe(beforeClick);
+
+    const press = await evaluateJevRisk(
+      recorder.pi as Parameters<typeof evaluateJevRisk>[0],
+      {
+        toolName: "sf_browser_press",
+        input: { key: "ArrowDown" },
+        cwd: ctx.cwd,
+        sessionId,
+        config: clickInput.config,
+      },
+      undefined,
+      { mode: "enforce" },
+    );
+    expect(press.decision).toBeUndefined();
+    expect(press.comparison).toMatchObject({
+      source: "rules_fallback",
+      reason: "Jev browser press lacks live page and focus evidence; using Safety Kernel fallback",
+    });
+
+    writeLatestBrowserSnapshotRefs({ sessionId, snapshot, url });
+    expect(findLatestBrowserSnapshotPageLookup(sessionId).status).toBe("fresh");
+  });
+
+  it("invalidates page evidence for editor writes and waits without invalidating click refs", async () => {
+    const { sessionId, ctx } = session();
+    vi.mocked(runAgentBrowser).mockImplementation(async (_pi, args) => {
+      if (args?.[0] === "eval")
+        return browserResult(
+          JSON.stringify({
+            ok: true,
+            action: "write",
+            candidate: {
+              editorIndex: 0,
+              kind: "textarea",
+              readOnly: false,
+              framePath: [],
+              sameOrigin: true,
+            },
+            previousLength: 1,
+            newLength: 2,
+            verification: "matched",
+            inaccessibleFrameCount: 0,
+          }),
+        );
+      return browserResult();
+    });
+    await runEditorOperation({} as ExtensionAPI, ctx, {
+      action: "write",
+      editorIndex: 0,
+      value: "ab",
+    });
+    expect(findLatestBrowserSnapshotPageLookup(sessionId).status).toBe("stale");
+    expect(findLatestBrowserSnapshotRefLookup(sessionId, "@e9").status).toBe("fresh");
+
+    writeLatestBrowserSnapshotRefs({ sessionId, snapshot, url });
+    const recorder = createRuntimeRecorder();
+    registerSfBrowserWaitTool(recorder.pi as unknown as ExtensionAPI);
+    const tool = (recorder.pi.getAllTools() as ActionTool[]).find(
+      (candidate) => candidate.name === "sf_browser_wait",
+    );
+    await tool!.execute("stub-wait", { ms: 0 }, new AbortController().signal, undefined, ctx);
+    expect(findLatestBrowserSnapshotPageLookup(sessionId).status).toBe("stale");
+    expect(findLatestBrowserSnapshotRefLookup(sessionId, "@e9").status).toBe("fresh");
+  });
+
+  it("invalidates page evidence before dismissing an ambient overlay", async () => {
+    const { sessionId, ctx } = session();
+    vi.mocked(runAgentBrowser).mockImplementation(async (_pi, args) => {
+      if (args?.[0] === "snapshot") return browserResult('- button "Close banner" [ref=e10]');
+      if (args?.[0] === "click") {
+        expect(findLatestBrowserSnapshotPageLookup(sessionId).status).toBe("stale");
+        return browserResult();
+      }
+      return browserResult();
+    });
+    const result = await dismissAmbientOverlays({} as ExtensionAPI, ctx.cwd, undefined, sessionId);
+    expect(result.dismissedRefs).toEqual(["e10"]);
+    expect(findLatestBrowserSnapshotPageLookup(sessionId).status).toBe("stale");
+    expect(findLatestBrowserSnapshotRefLookup(sessionId, "@e9").status).toBe("fresh");
+  });
+});
