+    browserPage?: { status: "fresh" | "stale" | "missing"; url: string; snapshot: string };
+  };
+}
+
+function fixtureEnv(row: CorpusCase): SfEnvironment | null {
+  const org = row.observations.org;
+  if (!org) return null;
+  return {
+    cli: { installed: true, version: "2.0.0" },
+    project: { detected: true },
+    config: { hasTargetOrg: true, targetOrg: org.alias, location: "Global" },
+    org: {
+      detected: org.type !== "unknown",
+      alias: org.alias,
+      username: `${org.alias.toLowerCase()}@example.test`,
+      orgType: org.type,
+    },
+    detectedAt: 0,
+  };
+}
+
+function fixtureBrowser(row: CorpusCase): BrowserSnapshotRefLookup {
+  const browser = row.observations.browser;
+  if (!browser || browser.status === "missing") return { status: "missing-ref" };
+  const ref = {
+    ref: String(row.input.ref),
+    role: browser.role,
+    label: browser.label,
+    line: `- ${browser.role} "${browser.label}" [ref=${row.input.ref}]`,
+  };
+  return {
+    status: browser.status,
+    ref,
+    ageMs: browser.status === "stale" ? 120_001 : 0,
+    session: { sessionId: "guardrail-corpus", capturedAt: "2026-09-21T00:00:00.000Z", refs: [ref] },
+    url: "https://org.example.test/lightning/setup/example",
+  };
+}
+
+function fixtureBrowserPage(row: CorpusCase): BrowserSnapshotPageLookup {
+  const page = row.observations.browserPage;
+  if (!page || page.status === "missing") return { status: "missing-session" };
+  if (!page.snapshot.trim()) throw new Error("Authored browser page snapshot is empty");
+  return {
+    status: page.status,
+    session: {
+      sessionId: "guardrail-corpus",
+      capturedAt: "2026-09-21T00:00:00.000Z",
+      url: page.url,
+      snapshotSha256: hash(page.snapshot),
+      refs: [],
+    },
+    ageMs: page.status === "stale" ? 120_001 : 0,
+  };
+}
+
+function fixtureConfig(row: CorpusCase): GuardrailConfig {
+  const config = readBundledConfig();
+  for (const [id, behavior] of Object.entries(row.policyBehaviors ?? {})) {
+    const rule = [
+      ...config.policies.rules,
+      ...config.commandGate.patterns,
+      ...config.commandGate.autoDenyPatterns,
+      ...config.orgAwareGate.rules,
+    ].find((rule) => rule.id === id);
+    if (!rule) throw new Error(`Unknown exact policy ${id}`);
+    rule.behavior = behavior;
+  }
+  return config;
+}
+
+function validateAuthoredRequest(row: CorpusCase): void {
+  if (!row.toolName.startsWith("data360_")) return;
+  const name = String(row.input.action ?? "");
+  const metaActions = ["help", "actions.list", "actions.search", "action.describe", "examples.get"];
+  if (metaActions.includes(name)) return;
+  if (row.toolName === "data360_discover" && name === "readiness.probe") return;
+  const params = row.input.params as Record<string, unknown> | undefined;
+  if (row.toolName === "data360_api" && name === "rest.request") {
+    for (const key of ["method", "path"]) {
+      expect(
+        typeof params?.[key] === "string" && Boolean(String(params[key]).trim()),
+        `${row.id}: raw REST ${key}`,
+      ).toBe(true);
+    }
+    return;
+  }
+  const action = findData360Action(row.toolName as Data360V2ToolName, name);
+  expect(action, `${row.id}: actual Data 360 action exists`).toBeDefined();
+  for (const key of action.requiredParams) {
+    const value = params?.[key];
+    expect(
+      value !== undefined && value !== null && value !== "",
+      `${row.id}: required parameter ${key}`,
+    ).toBe(true);
+  }
+}
+
+// Only known incomplete request facts that the runtime itself sends to the
+// existing rules may remove a fixture from the model denominator. Host lookup
+// errors and baseline consistency failures remain fatal to the corpus export.
+function authoredInputFallbackReason(error: unknown): string | undefined {
+  if (!(error instanceof Error)) return undefined;
+  const message = error.message;
+  if (message === "Jev Salesforce org identity unverified; using Safety Kernel fallback")
+    return message;
+  return /^Incomplete Jev risk input(?::|$)/.test(message) ||
+    /^Jev risk input exceeds (?:structural limits|byte limit(?: after host facts)?)$/.test(
+      message,
+    ) ||
+    message === "Invalid Unicode in Jev risk input" ||
+    message === "Incomplete Jev browser facts: fresh reference lacks observed label or role"
+    ? message.slice(0, 512)
+    : undefined;
+}
+
+async function prepareAuthoredRiskInput(
+  input: Parameters<typeof prepareJevRiskInput>[0],
+  baseline: Parameters<typeof prepareJevRiskInput>[1],
+  policyFloor: boolean,
+): Promise<{
+  riskInput: ReturnType<typeof buildJevRiskInput> | null;
+  modelEligible: boolean;
+  fallbackReason?: string;
+}> {
+  if (input.toolName === "sf_browser_click")
+    return {
+      riskInput: null,
+      modelEligible: false,
+      ...(policyFloor
+        ? {}
+        : {
+            fallbackReason:
+              typeof input.input.ref === "string" && input.input.ref.trim()
+                ? JEV_BROWSER_CLICK_FALLBACK_REASON
+                : "Incomplete Jev risk input: missing ref",
+          }),
+    };
+  if (input.toolName === "sf_browser_press")
+    return {
+      riskInput: null,
+      modelEligible: false,
+      ...(policyFloor ? {} : { fallbackReason: JEV_BROWSER_PRESS_FALLBACK_REASON }),
+    };
+  const modelEligible = jevRiskEligible(input) && !policyFloor;
+  try {
+    return {
+      riskInput: modelEligible
+        ? await prepareJevRiskInput(input, baseline)
+        : buildJevRiskInput(input),
+      modelEligible,
+    };
+  } catch (error) {
+    const fallbackReason = authoredInputFallbackReason(error);
+    if (!fallbackReason) throw error;
+    return { riskInput: null, modelEligible: false, fallbackReason };
+  }
+}
