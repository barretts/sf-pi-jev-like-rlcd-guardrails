+    async evaluate(input) {
+      seen.push(input);
+      return {
+        action,
+        reason: "risk_detected",
+        allowScore: action === "allow" ? 0.99 : 0.01,
+        elapsedMs: 1,
+        inputSha256: createHash("sha256").update(canonical(input)).digest("hex"),
+        inputTokens: 100,
+        calibration: "uncalibrated",
+      };
+    },
+  };
+}
+
+function pi(model: JevRiskProvider) {
+  return {
+    events: {
+      emit: (_event: string, request: { providers: JevRiskProvider[] }) => {
