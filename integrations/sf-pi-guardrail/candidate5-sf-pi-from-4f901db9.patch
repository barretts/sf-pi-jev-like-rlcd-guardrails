+/* SPDX-License-Identifier: Apache-2.0 */
+/**
+ * Matched Pi tool_call workflows. The guarded operations never reach real
+ * tools: execution below is only an in-memory receipt counter. A deterministic
+ * provider exercises the integration contract, not model effectiveness.
+ *
+ * Run with GUARDRAIL_WORKFLOW_OUTPUT=/tmp/guardrail-workflows.json to retain
+ * a timing and outcome receipt. Cold hook setup and warm checks are separate.
+ */
+import { createHash } from "node:crypto";
+import { writeFileSync } from "node:fs";
+import { performance } from "node:perf_hooks";
+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createRuntimeRecorder } from "../../../scripts/runtime-surface/harness.ts";
+import type { GuardrailConfig } from "../lib/types.ts";
+import { DECISION_ENTRY_TYPE } from "../lib/types.ts";
+import type { JevRiskInput, JevRiskProvider, JevRiskComparison } from "../lib/jev-risk.ts";
+import { JEV_RISK_COMPARISON_ENTRY, JEV_RISK_PROVIDER_EVENT } from "../lib/jev-risk.ts";
+
+const state = vi.hoisted(() => ({ config: undefined as GuardrailConfig | undefined }));
+vi.mock("../lib/config.ts", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("../lib/config.ts")>();
+  return {
+    ...actual,
+    loadConfig: () => ({ config: state.config ?? actual.readBundledConfig(), source: "bundled" }),
+  };
+});
+vi.mock("../lib/guardrail-settings.ts", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../lib/guardrail-settings.ts")>()),
+  readGuardrailPiSettings: () => ({}),
+}));
+vi.mock("../../../lib/common/sf-environment/shared-runtime.ts", () => ({
+  getCachedSfEnvironment: () => ({
+    config: { targetOrg: "Dev" },
+    org: { detected: true, alias: "Dev", orgType: "scratch" },
+  }),
+}));
+vi.mock("../../../lib/common/sf-environment/detect.ts", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../../lib/common/sf-environment/detect.ts")>()),
+  detectOrg: async () => ({ detected: false }),
+  detectConfig: async () => ({ hasTargetOrg: true, targetOrg: "Dev" }),
+}));
+
+import sfGuardrail from "../index.ts";
+import { readBundledConfig } from "../lib/config.ts";
+import { forgetSessionApprovals } from "../lib/approval-ledger.ts";
+import { getJevRiskBaselineSha256 } from "../lib/risk-baseline-identity.ts";
+
+type Mode = "off" | "shadow" | "enforce";
+interface Request {
+  toolName: string;
+  input: Record<string, unknown>;
+}
+interface Step {
+  id: string;
+  workflow: string;
+  request: Request;
+  approval: "Block" | "Allow once";
+  retryOf?: string;
+}
+interface Entry {
+  type: "custom";
+  customType: string;
+  data: Record<string, unknown>;
+}
+
+// The same immutable request list and operator answers run in every mode.
+const steps: readonly Step[] = [
+  {
+    id: "quoted-read",
+    workflow: "harmless quoted text",
+    request: { toolName: "bash", input: { command: "echo 'rm -rf is only quoted text'" } },
+    approval: "Block", // A prompt here would be an unnecessary interruption.
+  },
+  {
+    id: "apex-first",
+    workflow: "native approval and retry",
+    request: {
+      toolName: "sf_apex",
+      input: {
+        action: "anon.run",
+        body: "SideEffectDispatcher.run();",
+        allow_mutation: false,
+        target_org: "Dev",
+      },
+    },
+    approval: "Block",
+  },
+  {
+    id: "apex-retry",
+    workflow: "native approval and retry",
+    request: {
+      toolName: "sf_apex",
+      input: {
+        action: "anon.run",
+        body: "SideEffectDispatcher.run();",
+        allow_mutation: false,
+        target_org: "Dev",
+      },
+    },
+    approval: "Allow once",
+    retryOf: "apex-first",
+  },
+  {
+    id: "canvas-api",
+    workflow: "semantic API risk",
+    request: {
+      toolName: "bash",
+      input: {
+        command:
+          'curl -X POST https://slack.com/api/canvases.edit -H \'Content-Type: application/json\' -d \'{"canvas_id":"fixture-canvas","changes":[{"operation":"insert","document_content":{"type":"markdown","markdown":"Fixture"}}]}\'',
+      },
+    },
+    approval: "Allow once",
+  },
+  {
+    id: "protected-manifest",
+    workflow: "exact hard block",
+    request: {
+      toolName: "write",
+      input: { path: "/project/destructiveChanges.xml", content: "<fixture />" },
+    },
+    approval: "Block",
+  },
+];
+
+function canonical(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+  if (value && typeof value === "object") {
+    return `{${Object.keys(value)
+      .sort()
+      .map((key) => `${JSON.stringify(key)}:${canonical((value as Record<string, unknown>)[key])}`)
+      .join(",")}}`;
+  }
+  return JSON.stringify(value);
+}
+
+function stubProvider() {
+  const provider: JevRiskProvider = {
+    version: 1,
+    id: "jev",
+    // This flag only lets the hook's enforce branch be exercised in a test.
+    // No trained model or qualification receipt is involved.
+    qualified: true,
+    qualificationBaselineSha256: getJevRiskBaselineSha256(),
+    modelSha256: "b".repeat(64),
+    protocolSha256: "a".repeat(64),
+    evaluate: vi.fn(async (input: JevRiskInput) => {
+      const confirm =
+        input.toolName === "bash" &&
+        typeof input.input.command === "string" &&
+        input.input.command.includes("canvases.edit");
+      const action: "allow" | "confirm" = confirm ? "confirm" : "allow";
+      const reason: "risk_detected" | "safe_classification" = confirm
+        ? "risk_detected"
+        : "safe_classification";
+      return {
+        action,
+        reason,
+        allowScore: confirm ? 0.01 : 0.999,
+        elapsedMs: 0,
+        inputTokens: 1,
+        inputSha256: createHash("sha256").update(canonical(input)).digest("hex"),
+        calibration: "uncalibrated" as const,
+      };
+    }),
+  };
+  return provider;
+}
+
+function percentile95(values: number[]): number {
+  const sorted = [...values].sort((a, b) => a - b);
+  return sorted[Math.ceil(sorted.length * 0.95) - 1] ?? 0;
+}
+
+async function runMode(mode: Mode) {
+  vi.stubEnv("SF_GUARDRAIL_JEV_MODE", mode);
+  forgetSessionApprovals();
+  const provider = stubProvider();
+  const entries: Entry[] = [];
+  const prompts: Array<{ step: string; choices: string[] }> = [];
+  const executionReceipts: string[] = [];
+  let currentStep = steps[0]!;
+  const coldStartedAt = performance.now();
+  const recorder = createRuntimeRecorder();
+  Object.assign(recorder.pi, {
+    appendEntry: (customType: string, data: Record<string, unknown>) => {
+      entries.push({ type: "custom", customType, data });
+    },
+  });
+  recorder.pi.events.on(JEV_RISK_PROVIDER_EVENT, (request: { providers: JevRiskProvider[] }) =>
+    request.providers.push(provider),
+  );
+  sfGuardrail(recorder.pi as unknown as ExtensionAPI);
+  const ctx = {
+    cwd: "/project",
+    hasUI: true,
+    signal: new AbortController().signal,
+    sessionManager: {
+      getSessionId: () => `matched-workflow-${mode}`,
+      getEntries: () => entries,
+      getBranch: () => [],
+    },
+    ui: {
+      notify: vi.fn(),
+      setStatus: vi.fn(),
+      select: vi.fn(async (_title: string, choices: string[]) => {
+        prompts.push({ step: currentStep.id, choices });
+        return currentStep.approval;
+      }),
+    },
+  } as unknown as ExtensionContext;
+  for (const handler of recorder.handlers.get("session_start") ?? []) await handler({}, ctx);
+  const coldInitializationMs = performance.now() - coldStartedAt;
+  const hook = recorder.handlers.get("tool_call")?.[0];
+  if (!hook) throw new Error("The real sf-guardrail tool_call hook was not registered");
+
+  const rows = [];
+  for (const step of steps) {
+    currentStep = step;
+    const entryStart = entries.length;
+    const promptStart = prompts.length;
+    const startedAt = performance.now();
+    const result = (await hook(step.request, ctx)) as { block?: boolean } | undefined;
+    const warmHookMs = performance.now() - startedAt;
+    const accepted = result?.block !== true;
+    // The only "tool" is this counter. It cannot perform a shell, file,
+    // Salesforce, Slack, browser, or network operation.
+    if (accepted) executionReceipts.push(step.id);
+    const freshEntries = entries.slice(entryStart);
+    const decision = freshEntries.find((entry) => entry.customType === DECISION_ENTRY_TYPE)?.data;
+    const comparison = freshEntries.find((entry) => entry.customType === JEV_RISK_COMPARISON_ENTRY)
+      ?.data as unknown as JevRiskComparison | undefined;
+    rows.push({
+      id: step.id,
+      workflow: step.workflow,
+      accepted,
+      stubExecuted: accepted,
+      confirmationCount: prompts.length - promptStart,
+      retryOf: step.retryOf,
+      warmHookMs,
+      auditOutcome: decision?.outcome,
+      auditRiskSource: (decision?.risk as { source?: string } | undefined)?.source,
+      comparisonSource: comparison?.source,
+      comparisonBaseline: comparison?.baseline,
+      comparisonActual: comparison?.actual,
+      comparisonPrediction: comparison?.prediction,
+      warmRiskCheckMs: comparison?.elapsedMs,
+    });
+  }
+  const retries = rows.filter(
+    (row) => row.retryOf && rows.find((earlier) => earlier.id === row.retryOf)?.accepted === false,
+  ).length;
+  const warmRiskChecks = rows
+    .map((row) => row.warmRiskCheckMs)
+    .filter((elapsed): elapsed is number => elapsed !== undefined);
+  return {
+    mode,
+    coldInitializationMs,
+    totalWarmHookMs: rows.reduce((sum, row) => sum + row.warmHookMs, 0),
+    warmHookP95Ms: percentile95(rows.map((row) => row.warmHookMs)),
+    warmRiskCheckP95Ms: warmRiskChecks.length ? percentile95(warmRiskChecks) : null,
+    totalElapsedMs: performance.now() - coldStartedAt,
+    confirmations: prompts.length,
+    retries,
+    acceptedOutcomes: rows.map((row) => row.accepted),
+    executionReceipts,
+    providerCalls: vi.mocked(provider.evaluate).mock.calls.length,
+    rows,
+    unexpectedExecs: recorder.unexpectedExecs,
+  };
+}
