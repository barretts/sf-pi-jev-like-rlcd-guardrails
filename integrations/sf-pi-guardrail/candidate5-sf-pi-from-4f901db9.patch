+  return [
+    ...[...source.matchAll(staticImports)].flatMap((match) => (match[1] ? [match[1]] : [])),
+    ...[...source.matchAll(dynamicImports)].flatMap((match) => (match[1] ? [match[1]] : [])),
+    ...[...source.matchAll(localRequires)].flatMap((match) => (match[1] ? [match[1]] : [])),
+  ];
+}
+
+function resolveLocalImport(importer: string, specifier: string): string {
+  const relative = path.posix.normalize(path.posix.join(path.posix.dirname(importer), specifier));
+  if (relative === ".." || relative.startsWith("../") || path.posix.isAbsolute(relative))
+    throw new Error(`Jev risk baseline import escapes repository: ${importer} -> ${specifier}`);
+  const candidates = path.posix.extname(relative)
+    ? [relative]
+    : [
+        `${relative}.ts`,
+        `${relative}.tsx`,
+        `${relative}.js`,
+        `${relative}.mjs`,
+        `${relative}.json`,
+        `${relative}/index.ts`,
+        `${relative}/index.tsx`,
+      ];
+  const resolved = candidates.find((candidate) => existsSync(path.join(root, candidate)));
+  if (!resolved) throw new Error(`Missing Jev risk baseline import: ${importer} -> ${specifier}`);
+  return resolved;
+}
+
+export function calculateJevRiskBaselineIdentity(
+  readSource: (absolutePath: string) => Buffer = (file) => readFileSync(file),
+): { sha256: string; sources: Record<string, string> } {
+  const roots = [...JEV_RISK_BASELINE_FILES];
+  if (new Set(roots).size !== roots.length) throw new Error("Duplicate Jev risk baseline source");
+  const pending: string[] = [...roots];
+  const hashes = new Map<string, string>();
+  let totalBytes = 0;
+  while (pending.length) {
+    const file = pending.pop();
+    if (file === undefined) break;
+    if (hashes.has(file)) continue;
+    if (hashes.size >= MAX_BASELINE_FILES)
+      throw new Error("Jev risk baseline import closure too large");
+    const bytes = readSource(path.join(root, file));
+    if (bytes.length > MAX_SOURCE_BYTES) throw new Error("Jev risk baseline source exceeds 2 MiB");
+    totalBytes += bytes.length;
+    if (totalBytes > MAX_BASELINE_BYTES) throw new Error("Jev risk baseline sources exceed 16 MiB");
+    hashes.set(file, sha256(bytes));
+    if (/\.(?:[cm]?js|tsx?)$/.test(file))
+      for (const specifier of localImports(bytes.toString("utf8")))
+        pending.push(resolveLocalImport(file, specifier));
+  }
+  const sources = Object.fromEntries(
+    [...hashes].sort(([left], [right]) => (left < right ? -1 : left > right ? 1 : 0)),
+  );
+  return Object.freeze({
+    sha256: sha256(JSON.stringify(sources)),
+    sources: Object.freeze(sources),
+  });
+}
+
+/** Lazy, once per loaded runtime. Factory/startup registration does not read sources. */
+export function getJevRiskBaselineIdentity(): { sha256: string; sources: Record<string, string> } {
+  cached ??= calculateJevRiskBaselineIdentity();
+  return cached;
+}
+
+export const getJevRiskBaselineSha256 = (): string => getJevRiskBaselineIdentity().sha256;
