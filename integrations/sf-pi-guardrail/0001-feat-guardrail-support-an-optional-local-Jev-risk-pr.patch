@@ -0,0 +1,474 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/** Export actual old-engine outcomes with independently authored mock host facts. */
+import { createHash } from "node:crypto";
+import { execFileSync } from "node:child_process";
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { performance } from "node:perf_hooks";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { describe, expect, it, vi } from "vitest";
+import type { BrowserSnapshotRefLookup } from "../../../lib/common/sf-browser-snapshot-state.ts";
+import type { SfEnvironment } from "../../../lib/common/sf-environment/types.ts";
+import type { GuardrailConfig, OrgTypeFilter, RuleBehavior } from "../lib/types.ts";
+
+let mockedEnv: SfEnvironment | null = null;
+let mockedBrowser: BrowserSnapshotRefLookup = { status: "missing-session" };
+
+vi.mock("../../../lib/common/sf-environment/shared-runtime.ts", () => ({
+  getCachedSfEnvironment: () => mockedEnv,
+}));
+vi.mock("../../../lib/common/sf-environment/detect.ts", () => ({
+  detectConfig: async () => ({ hasTargetOrg: false }),
+  detectOrg: async () => ({ detected: false, orgType: "unknown" }),
+}));
+vi.mock("../../../lib/common/sf-browser-snapshot-state.ts", () => ({
+  findLatestBrowserSnapshotRefLookup: () => mockedBrowser,
+}));
+vi.mock("node:fs", async () => {
+  const actual = await vi.importActual<typeof import("node:fs")>("node:fs");
+  // Exact policy examples explicitly describe existing protected paths. This
+  // avoids reading user credentials or writing browser/global state.
+  return { ...actual, existsSync: () => true };
+});
+
+import { readBundledConfig } from "../lib/config.ts";
+import {
+  buildJevRiskInput,
+  evaluateJevRisk,
+  jevRiskEligible,
+  jevRiskPolicyFloor,
+} from "../lib/jev-risk.ts";
+import { evaluateSafety } from "../lib/safety-kernel.ts";
+import { getJevRiskBaselineIdentity } from "../lib/risk-baseline-identity.ts";
+import { createRuntimeRecorder } from "../../../scripts/runtime-surface/harness.ts";
+import { findData360Action } from "../../sf-data360/lib/v2/action-registry.ts";
+import type { Data360V2ToolName } from "../../sf-data360/lib/v2/action-types.ts";
+
+interface CorpusCase {
+  id: string;
+  groupId: string;
+  family: string;
+  split: "train" | "validation" | "test";
+  expected: "allow" | "confirm" | "block";
+  rubricId: string;
+  tags: string[];
+  toolName: string;
+  input: Record<string, unknown>;
+  policyBehaviors?: Record<string, RuleBehavior>;
+  observations: {
+    org?: { alias: string; type: OrgTypeFilter } | null;
+    browser?: { label: string; role: string; status: "fresh" | "stale" | "missing" };
+  };
+}
+
+function fixtureEnv(row: CorpusCase): SfEnvironment | null {
+  const org = row.observations.org;
+  if (!org) return null;
+  return {
+    cli: { installed: true, version: "2.0.0" },
+    project: { detected: true },
+    config: { hasTargetOrg: true, targetOrg: org.alias, location: "Global" },
+    org: {
+      detected: org.type !== "unknown",
+      alias: org.alias,
+      username: `${org.alias.toLowerCase()}@example.test`,
+      orgType: org.type,
+    },
+    detectedAt: 0,
+  };
+}
+
+function fixtureBrowser(row: CorpusCase): BrowserSnapshotRefLookup {
+  const browser = row.observations.browser;
+  if (!browser || browser.status === "missing") return { status: "missing-ref" };
+  const ref = {
+    ref: String(row.input.ref),
+    role: browser.role,
+    label: browser.label,
+    line: `- ${browser.role} "${browser.label}" [ref=${row.input.ref}]`,
+  };
+  return {
+    status: browser.status,
+    ref,
+    ageMs: browser.status === "stale" ? 120_001 : 0,
+    session: { sessionId: "guardrail-corpus", capturedAt: "2026-09-21T00:00:00.000Z", refs: [ref] },
+    url: "https://org.example.test/lightning/setup/example",
+  };
+}
+
+function fixtureConfig(row: CorpusCase): GuardrailConfig {
+  const config = readBundledConfig();
+  for (const [id, behavior] of Object.entries(row.policyBehaviors ?? {})) {
+    const rule = [
+      ...config.policies.rules,
+      ...config.commandGate.patterns,
+      ...config.commandGate.autoDenyPatterns,
+      ...config.orgAwareGate.rules,
+    ].find((rule) => rule.id === id);
+    if (!rule) throw new Error(`Unknown exact policy ${id}`);
+    rule.behavior = behavior;
+  }
+  return config;
+}
+
+function validateAuthoredRequest(row: CorpusCase): void {
+  if (!row.toolName.startsWith("data360_")) return;
+  const name = String(row.input.action ?? "");
+  const metaActions = ["help", "actions.list", "actions.search", "action.describe", "examples.get"];
+  if (metaActions.includes(name)) return;
+  if (row.toolName === "data360_discover" && name === "readiness.probe") return;
+  const params = row.input.params as Record<string, unknown> | undefined;
+  if (row.toolName === "data360_api" && name === "rest.request") {
+    for (const key of ["method", "path"]) {
+      expect(
+        typeof params?.[key] === "string" && Boolean(String(params[key]).trim()),
+        `${row.id}: raw REST ${key}`,
+      ).toBe(true);
+    }
+    return;
+  }
+  const action = findData360Action(row.toolName as Data360V2ToolName, name);
+  expect(action, `${row.id}: actual Data 360 action exists`).toBeDefined();
+  for (const key of action.requiredParams) {
+    const value = params?.[key];
+    expect(
+      value !== undefined && value !== null && value !== "",
+      `${row.id}: required parameter ${key}`,
+    ).toBe(true);
+  }
+}
+
+const root = fileURLToPath(new URL("../../../", import.meta.url));
+const sourceFiles = [
+  "extensions/sf-guardrail/SF_GUARDRAIL_DEFAULTS.json",
+  "extensions/sf-guardrail/lib/safety-kernel.ts",
+  "extensions/sf-guardrail/lib/safety-subject.ts",
+  "extensions/sf-guardrail/lib/safety-envelope.ts",
+  "extensions/sf-guardrail/lib/config.ts",
+  "extensions/sf-guardrail/lib/bash-ast.ts",
+  "extensions/sf-guardrail/lib/file-policy-gate.ts",
+  "extensions/sf-guardrail/lib/policies.ts",
+  "extensions/sf-guardrail/lib/command-gate.ts",
+  "extensions/sf-guardrail/lib/command-risk-gate.ts",
+  "extensions/sf-guardrail/lib/temp-cleanup.ts",
+  "extensions/sf-guardrail/lib/org-aware-gate.ts",
+  "extensions/sf-guardrail/lib/org-aware-risk-gate.ts",
+  "extensions/sf-guardrail/lib/org-context.ts",
+  "extensions/sf-guardrail/lib/native-tool-risk-registry.ts",
+  "extensions/sf-guardrail/lib/native-tool-risk-gate.ts",
+  "extensions/sf-guardrail/lib/rule-behavior.ts",
+  "extensions/sf-guardrail/lib/fingerprint.ts",
+  "extensions/sf-guardrail/lib/jev-risk.ts",
+  "lib/common/sf-browser-snapshot-state.ts",
+  "extensions/sf-guardrail/tests/guardrail-corpus.test.ts",
+  "extensions/sf-data360/registry/v2/actions.json",
+  "extensions/sf-data360/lib/v2/action-registry.ts",
+  "extensions/sf-data360/lib/v2/dispatcher.ts",
+];
+const hash = (bytes: string | Buffer) => createHash("sha256").update(bytes).digest("hex");
+
+describe.skipIf(!process.env.GUARDRAIL_CORPUS_PATH || !process.env.GUARDRAIL_BASELINE_OUTPUT)(
+  "authored guardrail corpus baseline export",
+  () => {
+    it(
+      "measures actual rule outcomes without executing tool requests",
+      async () => {
+        const corpusBytes = readFileSync(process.env.GUARDRAIL_CORPUS_PATH!);
+        const corpus = JSON.parse(corpusBytes.toString()) as {
+          version: number;
+          rubricVersion: string;
+          cases: CorpusCase[];
+        };
+        expect(corpus.version).toBe(1);
+        expect(corpus.cases.length).toBeGreaterThanOrEqual(300);
+        const ids = new Set<string>();
+        const groups = new Map<string, string>();
+        const states = new Map<string, string>();
+        const rows = [];
+        for (const row of corpus.cases) {
+          validateAuthoredRequest(row);
+          expect(ids.has(row.id), row.id).toBe(false);
+          ids.add(row.id);
+          expect(groups.get(row.groupId) ?? row.split).toBe(row.split);
+          groups.set(row.groupId, row.split);
+          mockedEnv = fixtureEnv(row);
+          mockedBrowser = fixtureBrowser(row);
+          const input = {
+            toolName: row.toolName,
+            input: row.input,
+            cwd: "/example/project",
+            sessionId: "guardrail-corpus",
+            config: fixtureConfig(row),
+          };
+          // Gold is already fixed. This separate call obtains the baseline; its
+          // risk labels/reasons are not added to the model request.
+          const baseline = await evaluateSafety(input);
+          const riskInput = buildJevRiskInput(input);
+          const policyFloor = jevRiskPolicyFloor(input, baseline);
+          const stateHash = hash(
+            JSON.stringify({ riskInput, policyBehaviors: row.policyBehaviors ?? {} }),
+          );
+          expect(states.get(stateHash) ?? row.groupId, `duplicate state ${row.id}`).toBe(
+            row.groupId,
+          );
+          states.set(stateHash, row.groupId);
+          if (policyFloor)
+            expect(baseline?.action ?? "allow", `exact policy ${row.id}`).toBe(row.expected);
+          rows.push({
+            id: row.id,
+            groupId: row.groupId,
+            family: row.family,
+            split: row.split,
+            expected: row.expected,
+            baseline: baseline?.action ?? "allow",
+            policyFloor,
+            modelEligible: jevRiskEligible(input) && !policyFloor,
+            riskInput,
+            rubricId: row.rubricId,
+            tags: row.tags,
+          });
+        }
+        const requiredFamilies = [
+          "shell",
+          "herdr",
+          "files",
+          "salesforce",
+          "apex",
+          "agentscript",
+          "data360",
+          "soql",
+          "canvas",
+          "browser",
+        ];
+        for (const split of ["train", "validation", "test"]) {
+          expect(
+            [...new Set(rows.filter((row) => row.split === split).map((row) => row.family))].sort(),
+          ).toEqual([...requiredFamilies].sort());
+          expect(
+            rows.some(
+              (row) =>
+                row.split === split &&
+                row.family === "files" &&
+                row.expected === "block" &&
+                row.policyFloor,
+            ),
+            `${split} exact hard block coverage`,
+          ).toBe(true);
+          for (const family of requiredFamilies.filter((family) => family !== "files")) {
+            const eligible = rows.filter(
+              (row) => row.split === split && row.family === family && row.modelEligible,
+            );
+            expect(
+              eligible.some((row) => row.expected === "allow"),
+              `${split}/${family} safe coverage`,
+            ).toBe(true);
+            expect(
+              eligible.some((row) => row.expected !== "allow"),
+              `${split}/${family} risk coverage`,
+            ).toBe(true);
+          }
+        }
+        const sources = Object.fromEntries(
+          sourceFiles.map((file) => [file, hash(readFileSync(path.join(root, file)))]),
+        );
+        const runtimeIdentity = getJevRiskBaselineIdentity();
+        const bundle = {
+          version: 1,
+          rubricVersion: corpus.rubricVersion,
+          corpusSha256: hash(corpusBytes),
+          baselineSourceSha256: runtimeIdentity.sha256,
+          provenanceSourceSha256: hash(JSON.stringify(sources)),
+          runtimeSourceSha256: runtimeIdentity.sources,
+          sfPiCommit: execFileSync("git", ["rev-parse", "HEAD"], {
+            cwd: root,
+            encoding: "utf8",
+          }).trim(),
+          sourceSha256: sources,
+          mockedExecution: true,
+          hostFactsProvenance:
+            "Authored generic org and browser observations; actual source resolves each full raw request independently.",
+          records: rows,
+          summary: {
+            cases: rows.length,
+            groups: groups.size,
+            disagreements: rows.filter((row) => row.expected !== row.baseline).length,
+            unsafeBaselineAllows: rows.filter(
