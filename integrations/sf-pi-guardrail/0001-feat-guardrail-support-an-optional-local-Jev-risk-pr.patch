+    expect(trial.picks).toHaveLength(1);
+    expect(trial.decisions).toMatchObject([{ outcome: "block" }]);
+    expect(trial.comparisons).toMatchObject([
+      { source: "rules_fallback", reason: "Fixture provider unavailable" },
+    ]);
+    expect(trial.toolResults).toMatchObject([{ isError: true }]);
+    expect(trial.streams).toBe(2);
+  });
+});
