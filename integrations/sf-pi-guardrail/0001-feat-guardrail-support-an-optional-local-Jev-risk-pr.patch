+    expect(measurements).toMatchObject([
+      { mode: "off", acceptedOutcomes: 2, confirmationCount: 1, retries: 0, errors: 0 },
+      { mode: "shadow", acceptedOutcomes: 2, confirmationCount: 1, retries: 0, errors: 0 },
+    ]);
+    if (process.env.GUARDRAIL_SDK_WORKFLOW_OUTPUT) {
+      const output = process.env.GUARDRAIL_SDK_WORKFLOW_OUTPUT;
+      mkdirSync(path.dirname(output), { recursive: true });
+      writeFileSync(
+        output,
+        JSON.stringify(
+          {
+            version: 1,
+            scope:
+              "Actual Pi AgentSession.prompt and ExtensionRunner; local scripted inference and counter-only custom tools; no local Jev candidate inference or external operations.",
+            workflow:
+              "Two identical bash requests: one confirmation followed by an exact session grant reuse.",
+            modelInitialization:
+              "Scripted stub provider; initializationMs measures SDK session setup.",
+            measurements,
+          },
+          null,
+          2,
+        ) + "\n",
+        { mode: 0o600 },
+      );
+    }
+  });
+  it("uses SDK headless blocking when no operator opt-in or human approval exists", async () => {
+    vi.stubEnv("SF_GUARDRAIL_JEV_MODE", "enforce");
+    const trial = await sdkTrial({
+      operations: [apex],
+      providers: [riskProvider()],
+      headless: true,
+    });
+    expect(trial.executions).toEqual([]);
+    expect(trial.picks).toEqual([]);
+    expect(trial.decisions).toMatchObject([{ outcome: "headless_block" }]);
+    expect(trial.toolResults).toMatchObject([{ isError: true }]);
+  });
+  it("audits provider outages and lets the SDK enforce the original denial without an exception bypass", async () => {
+    vi.stubEnv("SF_GUARDRAIL_JEV_MODE", "enforce");
+    const provider = riskProvider("allow");
+    provider.evaluate = vi.fn(async () => {
+      throw new Error("Fixture provider unavailable");
+    });
