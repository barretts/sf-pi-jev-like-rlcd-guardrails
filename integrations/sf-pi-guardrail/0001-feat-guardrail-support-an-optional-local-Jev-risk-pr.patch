+}
+export function jevRiskMode(env: NodeJS.ProcessEnv = process.env): JevRiskMode {
+  const mode = env.SF_GUARDRAIL_JEV_MODE ?? "off";
+  if (!["off", "shadow", "enforce"].includes(mode))
+    throw new Error("SF_GUARDRAIL_JEV_MODE must be off, shadow, or enforce");
+  return mode as JevRiskMode;
+}
+// Match Jev's canonical JSON, including numeric-looking and Unicode object keys.
+function canonical(value: unknown): string {
+  if (
+    value === null ||
+    typeof value === "string" ||
+    typeof value === "boolean" ||
+    (typeof value === "number" && Number.isFinite(value))
+  )
+    return JSON.stringify(value);
+  if (Array.isArray(value)) return "[" + value.map(canonical).join(",") + "]";
+  if (value && typeof value === "object")
+    return (
+      "{" +
+      Object.keys(value)
+        .sort((a, b) => {
+          const aa = Array.from(a),
+            bb = Array.from(b);
+          for (let i = 0; i < Math.min(aa.length, bb.length); i++) {
+            const d = aa[i].codePointAt(0) - bb[i].codePointAt(0);
+            if (d) return d;
+          }
+          return aa.length - bb.length;
+        })
+        .map((k) => JSON.stringify(k) + ":" + canonical(value[k]))
+        .join(",") +
+      "}"
+    );
+  throw new Error("Incomplete risk input");
+}
+const digest = (value: unknown) => createHash("sha256").update(canonical(value)).digest("hex");
+const policyJson = (value: unknown) => JSON.parse(JSON.stringify(value));
+const pin = (value: unknown): value is string =>
+  typeof value === "string" && /^[a-f0-9]{64}$/.test(value);
+function errorReason(error: unknown, fallback: string): string {
+  try {
+    if (nodeTypes.isProxy(error) || !(error instanceof Error)) return fallback;
+    const message = Object.getOwnPropertyDescriptor(error, "message");
+    if (message && "value" in message && typeof message.value === "string")
+      return message.value.slice(0, 512) || fallback;
+  } catch {
+    // A provider can reject with arbitrary objects; formatting must not throw.
+  }
+  return fallback;
+}
+const wellFormed = (value: string): boolean =>
+  !/[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/u.test(value);
+
+// Bound the scan before allocating a canonical request. Never invoke caller getters.
+function copyInput(value: unknown): Record<string, unknown> {
+  let nodes = 0;
+  let bytes = 0;
+  function visit(current: unknown, depth: number): unknown {
+    if (++nodes > JEV_RISK_INPUT_LIMITS.nodes || depth > JEV_RISK_INPUT_LIMITS.depth)
+      throw new Error("Jev risk input exceeds structural limits");
+    if (nodeTypes.isProxy(current)) throw new Error("Incomplete Jev risk input: proxy data");
+    if (typeof current === "string") {
+      if (!wellFormed(current)) throw new Error("Invalid Unicode in Jev risk input");
+      bytes += Buffer.byteLength(JSON.stringify(current));
+    } else if (
+      current === null ||
+      typeof current === "boolean" ||
+      (typeof current === "number" && Number.isFinite(current))
+    ) {
+      bytes += JSON.stringify(current).length;
+    } else if (Array.isArray(current)) {
+      if (current.length > JEV_RISK_INPUT_LIMITS.nodes - nodes)
+        throw new Error("Jev risk input exceeds structural limits");
+      bytes += current.length + 2;
+      const keys = Reflect.ownKeys(current);
+      if (
+        keys.length !== current.length + 1 ||
+        keys.some(
+          (key) =>
+            typeof key !== "string" ||
+            (key !== "length" && (!/^(0|[1-9]\d*)$/.test(key) || Number(key) >= current.length)),
+        )
+      )
+        throw new Error("Incomplete Jev risk input: extra array data");
+      return Object.freeze(
+        Array.from({ length: current.length }, (_unused, index) => {
+          const property = Object.getOwnPropertyDescriptor(current, String(index));
+          if (!property || !("value" in property)) throw new Error("Incomplete Jev risk input");
+          return visit(property.value, depth + 1);
+        }),
+      );
+    } else if (
+      current &&
+      typeof current === "object" &&
+      [Object.prototype, null].includes(Object.getPrototypeOf(current))
+    ) {
+      const ownKeys = Reflect.ownKeys(current);
+      if (
+        ownKeys.some(
+          (key) =>
+            typeof key !== "string" || !Object.getOwnPropertyDescriptor(current, key)?.enumerable,
+        )
+      )
+        throw new Error("Incomplete Jev risk input: hidden data");
+      const keys = ownKeys as string[];
+      if (keys.length > JEV_RISK_INPUT_LIMITS.nodes - nodes)
+        throw new Error("Jev risk input exceeds structural limits");
+      bytes += keys.length + 2;
+      const result: Record<string, unknown> = Object.create(null);
+      for (const key of keys) {
+        if (!wellFormed(key)) throw new Error("Invalid Unicode in Jev risk input");
+        bytes += Buffer.byteLength(JSON.stringify(key)) + 1;
+        const property = Object.getOwnPropertyDescriptor(current, key);
+        if (!property || !("value" in property)) throw new Error("Incomplete Jev risk input");
+        result[key] = visit(property.value, depth + 1);
+      }
+      return Object.freeze(result);
+    } else throw new Error("Incomplete Jev risk input");
+    if (bytes > JEV_RISK_INPUT_LIMITS.bytes) throw new Error("Jev risk input exceeds byte limit");
+    return current;
+  }
+  const result = visit(value, 0);
+  if (!result || typeof result !== "object" || Array.isArray(result))
+    throw new Error("Incomplete Jev risk input");
+  if (bytes > JEV_RISK_INPUT_LIMITS.bytes) throw new Error("Jev risk input exceeds byte limit");
+  return result as Record<string, unknown>;
+}
+
+function completeToolInput(input: SafetyKernelInput): void {
+  if (FILE_TOOLS.has(input.toolName)) return;
+  const field = isShell(input)
+    ? "command"
+    : input.toolName === "sf_browser_click"
+      ? "ref"
+      : input.toolName === "sf_browser_press"
+        ? "key"
+        : "action";
+  if (typeof input.input[field] !== "string" || !input.input[field].trim())
+    throw new Error(`Incomplete Jev risk input: missing ${field}`);
+}
+
+/** Org and snapshot observations are resolved independently of old risk labels. */
+export function buildJevRiskInput(input: SafetyKernelInput): JevRiskInput {
+  input = { ...input, input: copyInput(input.input) };
+  completeToolInput(input);
+  const facts: JevRiskInput["facts"] = {};
+  if (isShell(input) && typeof input.input.command === "string") {
+    facts.orgs = splitSimpleCommands(input.input.command).map((command) => {
+      const org = resolveOrgContext(command, input.cwd, input.config.productionAliases);
+      return { type: org.type, guessed: org.guessed, command };
+    });
+  } else if (
+    input.toolName === "sf_apex" ||
+    input.toolName === "agentscript_lifecycle" ||
+    input.toolName === "sf_soql" ||
+    input.toolName.startsWith("data360_")
+  ) {
+    const org = resolveOrgContextForTarget(
+      typeof input.input.target_org === "string" ? input.input.target_org : undefined,
+      input.cwd,
+      input.config.productionAliases,
+    );
+    facts.orgs = [{ type: org.type, guessed: org.guessed }];
+  }
+  if (input.toolName === "sf_browser_click") {
+    const lookup = findLatestBrowserSnapshotRefLookup(
+      input.sessionId,
+      typeof input.input.ref === "string" ? input.input.ref : undefined,
+    );
+    facts.browserRef = {
+      status:
+        lookup?.status === "fresh" ? "fresh" : lookup?.status === "stale" ? "stale" : "missing",
+      ...(lookup?.ref?.label ? { label: lookup.ref.label } : {}),
+      ...(lookup?.ref?.role ? { role: lookup.ref.role } : {}),
+      ...(lookup?.ref?.line
+        ? {
+            snapshotSha256: digest({
+              line: lookup.ref.line,
+              capturedAt: lookup.session?.capturedAt ?? null,
+              url: lookup.url ?? null,
+            }),
+          }
+        : {}),
+    };
+    if (
+      facts.browserRef.status === "fresh" &&
+      (!facts.browserRef.label?.trim() || !facts.browserRef.role?.trim())
+    )
+      throw new Error("Incomplete Jev browser facts: fresh reference lacks observed label or role");
+  }
+  const value = { version: 1 as const, toolName: input.toolName, input: input.input, facts };
+  if (Buffer.byteLength(canonical(value)) > JEV_RISK_INPUT_LIMITS.bytes)
+    throw new Error("Jev risk input exceeds byte limit after host facts");
+  return copyInput(value) as unknown as JevRiskInput;
+}
+
+/** Non-default exact command policy remains authoritative, including off/allow overrides. */
+function customCommandPolicy(config: GuardrailConfig): boolean {
+  const bundled = readBundledConfig();
+  return (
+    canonical(policyJson(config.commandGate)) !== canonical(policyJson(bundled.commandGate)) ||
+    canonical(policyJson(config.orgAwareGate)) !== canonical(policyJson(bundled.orgAwareGate))
+  );
+}
+export function jevRiskPolicyFloor(
+  input: SafetyKernelInput,
+  baseline?: ClassifiedDecision,
+): boolean {
+  if (
+    FILE_TOOLS.has(input.toolName) ||
+    baseline?.feature === "policies" ||
+    baseline?.action === "block" ||
+    baseline?.ruleId === "safe-temp-cleanup"
+  )
+    return true;
+  if (isShell(input)) {
+    if (customCommandPolicy(input.config)) return true;
+    if (
+      typeof input.input.command === "string" &&
+      evaluateCommand(input.input.command, input.config.commandGate)?.action === "allow"
+    )
+      return true;
+  }
+  return false;
+}
+export function jevRiskEligible(input: SafetyKernelInput): boolean {
+  return isShell(input) || NATIVE_TOOLS.has(input.toolName);
+}
+
+function modelDecision(
+  input: SafetyKernelInput,
+  baseline: ClassifiedDecision | undefined,
+  provider: JevRiskProvider,
+  prediction: Prediction,
+  riskInput: JevRiskInput,
+): ClassifiedDecision {
+  const fingerprint = digest({
+    operation: riskInput,
+    cwd: input.cwd,
+    orgIdentity: baseline?.orgId ?? baseline?.orgUsername ?? baseline?.orgAlias ?? null,
+    baselineImplementationSha256: getJevRiskBaselineSha256(),
+    config: policyJson(input.config),
+    model: provider.modelSha256,
+    protocol: provider.protocolSha256,
+  });
+  const action = prediction.action === "allow" ? "allow" : "confirm";
+  const subject =
+    baseline?.subject ??
+    (isShell(input) && typeof input.input.command === "string"
+      ? input.input.command
+      : `${input.toolName} operation ${prediction.inputSha256.slice(0, 12)}`);
+  return {
+    ...(baseline ?? {}),
+    ruleId: baseline?.ruleId ?? "jev-semantic-risk",
+    feature: baseline?.feature ?? (isShell(input) ? "commandGate" : "nativeToolGate"),
+    action,
+    fingerprint,
+    subject,
+    reason:
+      action === "allow"
+        ? "Jev classified this complete operation as safe without approval."
+        : prediction.action === "abstain"
+          ? "Jev could not confidently classify this operation as safe; approval is required."
+          : (baseline?.reason ??
+            "Jev detected a risky or ambiguous operation; approval is required."),
+    approvalScope:
+      action === "confirm"
+        ? {
+            fingerprint,
+            label: "this exact operation under this Jev model and policy",
+            operationFamily: baseline?.approvalScope?.operationFamily ?? "jev semantic operation",
+            riskTier: baseline?.approvalScope?.riskTier ?? "jev_semantic_exact",
+            allowSession:
+              baseline?.approvalScope?.allowSession === true &&
+              baseline?.orgType !== "production" &&
+              !baseline?.orgResolutionGuessed,
+          }
+        : undefined,
+    risk: {
+      source: "jev",
+      modelSha256: provider.modelSha256,
+      protocolSha256: provider.protocolSha256,
+      inputSha256: prediction.inputSha256,
+      allowScore: prediction.allowScore,
+      elapsedMs: prediction.elapsedMs,
+    },
+  };
+}
+
+export async function evaluateJevRisk(
+  pi: Pick<ExtensionAPI, "events">,
+  input: SafetyKernelInput,
+  baseline: ClassifiedDecision | undefined,
+  options: { mode?: JevRiskMode; signal?: AbortSignal; startedAt?: number } = {},
