+    expect(provider.evaluate).not.toHaveBeenCalled();
+    expect(trial.decisions).toMatchObject([{ outcome: "hard_block" }]);
+    expect(trial.toolResults).toMatchObject([{ isError: true }]);
+    expect(trial.events.filter((event) => event.type === "tool_execution_end")).toMatchObject([
+      { toolName: "bash", isError: true },
+    ]);
+    expect(trial.streams).toBe(2);
+  });
+  it("prevents SDK execution after a denied uncertain prediction and a claimed input approval", async () => {
+    vi.stubEnv("SF_GUARDRAIL_JEV_MODE", "enforce");
