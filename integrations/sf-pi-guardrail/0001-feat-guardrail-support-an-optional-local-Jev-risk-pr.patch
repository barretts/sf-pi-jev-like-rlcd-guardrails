+  const start = options.startedAt ?? performance.now();
+  let mode: JevRiskMode | "invalid" = "invalid";
+  const comparison: JevRiskComparison = {
+    version: 1,
+    timestamp: Date.now(),
+    mode,
+    toolName: input.toolName,
+    source: "rules_fallback",
+    baseline: baseline?.action ?? "allow",
+    actual: baseline?.action ?? "allow",
+    elapsedMs: 0,
+    reason: "provider_unavailable",
+  };
