+}));
+
+import sfGuardrail from "../index.ts";
+import { readBundledConfig } from "../lib/config.ts";
+import { forgetSessionApprovals } from "../lib/approval-ledger.ts";
+import { getJevRiskBaselineSha256 } from "../lib/risk-baseline-identity.ts";
+
+interface Operation {
+  toolName: string;
+  input: Record<string, unknown>;
+}
+const dangerous: Operation = { toolName: "bash", input: { command: "rm -rf ./work" } };
+const apex: Operation = {
+  toolName: "sf_apex",
+  input: {
+    action: "anon.run",
+    body: "callWithSideEffects();",
+    allow_mutation: true,
+    target_org: "Dev",
+  },
+};
+const MODEL: Model<"openai-completions"> = {
+  id: "scripted-sdk-fixture",
+  provider: "sf-guardrail-sdk-proof",
+  api: "openai-completions",
+  name: "Local scripted SDK fixture",
+  baseUrl: "https://sdk-fixture.invalid/v1",
+  reasoning: false,
+  input: ["text"],
+  cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+  contextWindow: 8_192,
+  maxTokens: 1_024,
+};
+const tempDirs: string[] = [];
+const sessions: AgentSession[] = [];
+
+function canonical(value: unknown): string {
+  if (Array.isArray(value)) return "[" + value.map(canonical).join(",") + "]";
+  if (value && typeof value === "object")
+    return (
+      "{" +
+      Object.keys(value)
+        .sort()
+        .map((key) => JSON.stringify(key) + ":" + canonical(value[key]))
+        .join(",") +
+      "}"
+    );
+  return JSON.stringify(value);
+}
+function riskProvider(action: "allow" | "confirm" | "abstain" = "confirm"): JevRiskProvider {
+  return {
+    version: 1,
+    id: "jev",
+    qualified: true,
+    get qualificationBaselineSha256() {
+      return getJevRiskBaselineSha256();
+    },
+    modelSha256: "b".repeat(64),
+    protocolSha256: "a".repeat(64),
+    evaluate: vi.fn(async (input: JevRiskInput) => ({
+      action,
+      reason: action === "allow" ? "safe_classification" : "risk_detected",
+      allowScore: action === "allow" ? 0.999 : 0.01,
+      elapsedMs: 1,
+      inputTokens: 100,
+      inputSha256: createHash("sha256").update(canonical(input)).digest("hex"),
+      calibration: "uncalibrated" as const,
+    })),
+  };
+}
+function scriptedMessage(operations?: Operation[]): AssistantMessage {
+  return {
+    role: "assistant",
+    content: operations
+      ? operations.map((operation, index) => ({
+          type: "toolCall" as const,
+          id: `fixture-call-${index}`,
+          name: operation.toolName,
+          arguments: operation.input,
+        }))
+      : [{ type: "text", text: "Stub workflow complete." }],
+    api: MODEL.api,
+    provider: MODEL.provider,
+    model: MODEL.id,
+    usage: {
+      input: 0,
+      output: 0,
+      cacheRead: 0,
+      cacheWrite: 0,
+      totalTokens: 0,
+      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+    },
+    stopReason: operations ? "toolUse" : "stop",
+    timestamp: Date.now(),
+  };
+}
+async function sdkTrial(options: {
+  operations: Operation[];
+  providers?: JevRiskProvider[];
+  pick?: string;
+  headless?: boolean;
+}) {
