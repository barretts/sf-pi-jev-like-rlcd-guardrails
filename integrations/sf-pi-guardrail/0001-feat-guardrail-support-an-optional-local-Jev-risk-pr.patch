+/* SPDX-License-Identifier: Apache-2.0 */
+/** Bind qualification to the installed guardrail and independently resolved facts. */
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import path from "node:path";
+
+const root = fileURLToPath(new URL("../../../", import.meta.url));
+export const JEV_RISK_BASELINE_FILES = [
+  "extensions/sf-guardrail/SF_GUARDRAIL_DEFAULTS.json",
+  "extensions/sf-guardrail/index.ts",
+  "extensions/sf-guardrail/lib/safety-kernel.ts",
+  "extensions/sf-guardrail/lib/safety-subject.ts",
+  "extensions/sf-guardrail/lib/safety-envelope.ts",
+  "extensions/sf-guardrail/lib/config.ts",
+  "extensions/sf-guardrail/lib/bash-ast.ts",
+  "extensions/sf-guardrail/lib/file-policy-gate.ts",
+  "extensions/sf-guardrail/lib/policies.ts",
+  "extensions/sf-guardrail/lib/command-gate.ts",
+  "extensions/sf-guardrail/lib/command-risk-gate.ts",
+  "extensions/sf-guardrail/lib/temp-cleanup.ts",
+  "extensions/sf-guardrail/lib/org-aware-gate.ts",
+  "extensions/sf-guardrail/lib/org-aware-risk-gate.ts",
+  "extensions/sf-guardrail/lib/org-context.ts",
+  "extensions/sf-guardrail/lib/native-tool-risk-registry.ts",
+  "extensions/sf-guardrail/lib/native-tool-risk-gate.ts",
+  "extensions/sf-guardrail/lib/rule-behavior.ts",
+  "extensions/sf-guardrail/lib/guardrail-settings.ts",
+  "extensions/sf-guardrail/lib/approval-scope.ts",
+  "extensions/sf-guardrail/lib/approval-ledger.ts",
+  "extensions/sf-guardrail/lib/hitl.ts",
+  "extensions/sf-guardrail/lib/power-tool-mode.ts",
+  "extensions/sf-guardrail/lib/fingerprint.ts",
+  "extensions/sf-guardrail/lib/jev-risk.ts",
+  "extensions/sf-guardrail/lib/risk-baseline-identity.ts",
+  "extensions/sf-guardrail/lib/types.ts",
+  "lib/common/sf-browser-snapshot-state.ts",
+  "lib/common/sf-environment/shared-runtime.ts",
+  "lib/common/sf-environment/detect.ts",
+  "extensions/sf-data360/registry/v2/actions.json",
+  "extensions/sf-data360/lib/v2/action-registry.ts",
+  "extensions/sf-data360/lib/v2/dispatcher.ts",
+] as const;
+
+const sha256 = (bytes: Buffer | string) => createHash("sha256").update(bytes).digest("hex");
+let cached: { sha256: string; sources: Record<string, string> } | undefined;
+
+/** Lazy, once per loaded runtime. Factory/startup registration does not read sources. */
+export function getJevRiskBaselineIdentity(): { sha256: string; sources: Record<string, string> } {
+  if (!cached) {
+    const sources = Object.fromEntries(
+      JEV_RISK_BASELINE_FILES.map((file) => {
+        const bytes = readFileSync(path.join(root, file));
+        if (bytes.length > 1_048_576) throw new Error("Jev risk baseline source exceeds 1 MiB");
+        return [file, sha256(bytes)];
+      }),
+    );
+    cached = Object.freeze({
+      sha256: sha256(JSON.stringify(sources)),
+      sources: Object.freeze(sources),
+    });
+  }
+  return cached;
+}
+
+export const getJevRiskBaselineSha256 = (): string => getJevRiskBaselineIdentity().sha256;
