+});
+afterEach(() => {
+  for (const session of sessions.splice(0)) session.dispose();
+  for (const dir of tempDirs.splice(0)) rmSync(dir, { recursive: true, force: true });
+  vi.unstubAllEnvs();
+});
+
+describe("Jev risk through Pi SDK tool execution", () => {
+  it("makes SDK hard blocks prevent actual stub execution despite a model allow and headless opt-ins", async () => {
+    state.config.commandGate.patterns = state.config.commandGate.patterns.map((pattern) =>
