+      for (const operation of operations) results.push(await trial.call(operation));
+      rows.push({
+        mode,
+        operations: operations.length,
+        accepted: results.filter((row) => row.accepted).length,
+        confirmations: trial.picks.length,
+        retries: 0,
+        totalElapsedMs: performance.now() - startedAt,
+        coldInitialization: "stub provider; no model loading",
+        execution: "local stub only",
+      });
+    }
+    expect(
+      rows.map(({ accepted, confirmations, retries }) => ({ accepted, confirmations, retries })),
+    ).toEqual(Array(3).fill({ accepted: 3, confirmations: 2, retries: 0 }));
+    if (process.env.GUARDRAIL_WORKFLOW_OUTPUT)
+      writeFileSync(
+        process.env.GUARDRAIL_WORKFLOW_OUTPUT,
+        JSON.stringify(
+          { version: 1, scope: "real Pi hook with stub tools and stub risk provider", rows },
+          null,
+          2,
+        ) + "\n",
+      );
+  });
+});
