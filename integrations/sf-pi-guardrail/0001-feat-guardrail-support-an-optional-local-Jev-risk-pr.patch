+          await evaluateCandidate(corpus.cases, bundle);
+        }
+      },
+      process.env.GUARDRAIL_EVALUATION_OUTPUT ? 600_000 : 30_000,
+    );
+  },
+);
+
+/** Real local model and bridge; only authored request fixtures reach the worker. */
+async function evaluateCandidate(
+  cases: CorpusCase[],
+  bundle: {
+    corpusSha256: string;
+    baselineSourceSha256: string;
+    records: Array<{
+      id: string;
+      groupId: string;
+      family: string;
+      split: string;
+      expected: string;
+      baseline: string;
+      policyFloor: boolean;
+      modelEligible: boolean;
+      riskInput: unknown;
+    }>;
+  },
+) {
+  const jevRoot = process.env.GUARDRAIL_JEV_ROOT;
+  if (!jevRoot) throw new Error("GUARDRAIL_JEV_ROOT must identify the built local Jev project");
+  const split = process.env.GUARDRAIL_EVALUATION_SPLIT ?? "validation";
+  if (!["validation", "test"].includes(split))
+    throw new Error("Evaluation split must be validation or test");
+  const load = (file: string) =>
+    import(/* @vite-ignore */ pathToFileURL(path.join(jevRoot, "dist", file)).href);
+  const [jev, core, evaluation, models] = await Promise.all([
+    load("guardrail-extension.js"),
+    load("core.js"),
+    load("guardrail-evaluation.js"),
+    load("models.js"),
+  ]);
+  const inventory = bundle.records.map((row) => ({
+    id: row.id,
+    groupId: row.groupId,
+    family: row.family,
+    split: row.split,
+    expected: row.expected,
+    baseline: row.baseline,
+    policyFloor: row.policyFloor,
+    modelEligible: row.modelEligible,
+    inputSha256: hash(core.canonical(row.riskInput)),
+  }));
+  const recorder = createRuntimeRecorder();
+  const coldStartedAt = performance.now();
+  const runtime = jev.registerGuardrailProvider(recorder.pi, { env: process.env });
+  try {
+    await runtime.warmup();
+    const coldInitializationMs = performance.now() - coldStartedAt;
+    const nativeBinarySha256 = (await models.hashArtifact(jev.guardrailConfig(process.env).binary))
+      .sha256;
+    const status = runtime.status();
+    if (!/^[a-f0-9]{64}$/.test(status.modelSha256 ?? ""))
+      throw new Error("Warmed candidate has no verified model identity");
+    const identity = {
+      split,
+      modelSha256: status.modelSha256,
+      corpusSha256: bundle.corpusSha256,
+      baselineSourceSha256: bundle.baselineSourceSha256,
+      nativeBinarySha256,
+      executionSurface: "sf_guardrail_bridge",
+    };
+    let frozen;
+    if (split === "test") {
+      if (!process.env.GUARDRAIL_CANDIDATE_FREEZE)
+        throw new Error(
+          "Held-out TEST requires GUARDRAIL_CANDIDATE_FREEZE selected from passing bridge validation",
+        );
+      frozen = JSON.parse(readFileSync(process.env.GUARDRAIL_CANDIDATE_FREEZE, "utf8"));
+      // This is deliberately before the first held-out model evaluation.
+      evaluation.assertGuardrailFreeze(frozen, identity, inventory);
+    }
+    const records = [];
+    for (const row of cases.filter((row) => row.split === split)) {
+      const startedAt = performance.now();
+      mockedEnv = fixtureEnv(row);
+      mockedBrowser = fixtureBrowser(row);
+      const input = {
+        toolName: row.toolName,
+        input: row.input,
+        cwd: "/example/project",
+        sessionId: "guardrail-corpus",
+        config: fixtureConfig(row),
+      };
+      const baseline = await evaluateSafety(input);
+      const evaluated = await evaluateJevRisk(recorder.pi, input, baseline, {
+        mode: "shadow",
+        startedAt,
+      });
+      const receipt = inventory.find((item) => item.id === row.id)!;
+      const comparison = evaluated.comparison;
+      const error =
+        receipt.modelEligible && comparison?.source !== "jev"
+          ? (comparison?.reason ?? "Eligible request produced no model comparison")
+          : undefined;
+      records.push({
+        id: receipt.id,
+        groupId: receipt.groupId,
+        family: receipt.family,
+        expected: receipt.expected,
+        baseline: receipt.baseline,
+        actual: comparison?.actual ?? baseline?.action ?? "allow",
+        modelEligible: receipt.modelEligible,
+        modelAnswered: receipt.modelEligible && comparison?.source === "jev",
+        policyFloor: receipt.policyFloor,
+        inputSha256: receipt.inputSha256,
+        elapsedMs: comparison?.elapsedMs ?? performance.now() - startedAt,
+        ...(comparison ? { evidence: comparison } : {}),
+        ...(error ? { error } : {}),
+      });
+      // Shadow classification never changes the enforcement owner or result.
+      expect(evaluated.decision).toBe(baseline);
+      if (records.length % 20 === 0)
+        console.info(
+          JSON.stringify({ phase: "sf_bridge_evaluation", split, completed: records.length }),
+        );
+    }
+    const report = evaluation.qualifyGuardrail(records, {
+      ...identity,
+      ...(frozen ? { freeze: frozen } : {}),
+    });
+    const output = path.resolve(process.env.GUARDRAIL_EVALUATION_OUTPUT!);
+    mkdirSync(path.dirname(output), { recursive: true });
+    writeFileSync(
+      output,
+      JSON.stringify(
+        {
+          ...report,
+          coldInitializationMs,
+          execution:
+            "Actual SF risk bridge and local Jev worker; dangerous tools are never executed; host facts are authored fixtures.",
+        },
+        null,
+        2,
+      ) + "\n",
+      { flag: "wx", mode: 0o600 },
+    );
+    console.info(
+      JSON.stringify({
+        phase: "sf_bridge_evaluated",
+        output,
+        split,
+        coldInitializationMs,
+        metrics: report.metrics,
+        gates: report.gates,
+        qualified: report.qualified,
+      }),
+    );
+  } finally {
+    await runtime.dispose();
+  }
+}
