+  const picks: string[][] = [];
+  const events: AgentSessionEvent[] = [];
+  let streams = 0;
+  const nextStream = () => {
+    const message = scriptedMessage(streams++ === 0 ? options.operations : undefined);
+    const stream = createAssistantMessageEventStream();
+    queueMicrotask(() => {
+      stream.push({ type: "start", partial: message });
+      stream.push({ type: "done", reason: message.stopReason as "toolUse" | "stop", message });
+      stream.end();
+    });
+    return stream;
+  };
+  const modelRuntime = await ModelRuntime.create({
+    credentials: new InMemoryCredentialStore(),
+    modelsStore: new InMemoryModelsStore(),
+    modelsPath: null,
+    allowModelNetwork: false,
+    refreshOnCreate: false,
+  });
+  modelRuntime.registerNativeProvider(
+    createProvider({
+      id: MODEL.provider,
+      name: "Guardrail SDK fixture",
+      auth: {
+        apiKey: {
+          name: "Fixture key",
+          async resolve() {
+            return { auth: { apiKey: "fixture-key" }, source: "test" };
+          },
+        },
+      },
+      models: [MODEL],
+      api: { "openai-completions": { stream: nextStream, streamSimple: nextStream } },
+    }),
+  );
+  const settingsManager = SettingsManager.inMemory({
+    compaction: { enabled: false },
+    retry: { enabled: false, maxRetries: 0, baseDelayMs: 0 },
+  });
+  const resourceLoader = new DefaultResourceLoader({
+    cwd,
+    agentDir: cwd,
+    settingsManager,
+    noExtensions: true,
+    noSkills: true,
+    noPromptTemplates: true,
+    noThemes: true,
+    noContextFiles: true,
+    systemPrompt: "Execute the local fixture tool calls.",
+    extensionFactories: [
+      sfGuardrail,
+      (pi) => {
+        pi.events.on(JEV_RISK_PROVIDER_EVENT, (request: { providers: JevRiskProvider[] }) => {
+          request.providers.push(...(options.providers ?? []));
+        });
+      },
+    ],
+  });
+  await resourceLoader.reload();
+  expect(resourceLoader.getExtensions().errors).toEqual([]);
+  const toolNames = [...new Set(options.operations.map((operation) => operation.toolName))];
+  const customTools: ToolDefinition[] = toolNames.map((name) => ({
+    name,
+    label: `Fixture ${name}`,
+    description: "Records local fixture execution without performing the requested operation.",
+    parameters: Type.Record(Type.String(), Type.Unknown()),
+    executionMode: "sequential",
+    async execute(_toolCallId, params) {
+      executions.push({ toolName: name, input: params as Record<string, unknown> });
+      return { content: [{ type: "text", text: "Local stub executed." }], details: {} };
+    },
+  }));
+  const { session } = await createAgentSession({
+    cwd,
+    agentDir: cwd,
+    model: MODEL,
+    modelRuntime,
+    settingsManager,
+    resourceLoader,
+    sessionManager: SessionManager.inMemory(cwd),
+    tools: toolNames,
+    customTools,
+  });
+  sessions.push(session);
+  session.subscribe((event) => events.push(event));
+  // Retain Pi's complete no-op UI surface; only the human choice is scripted.
+  const ui = {
+    ...session.extensionRunner.getUIContext(),
+    select: async (_title: string, choices: string[]) => {
+      picks.push(choices);
+      return options.pick;
+    },
+  } as ExtensionUIContext;
+  await session.bindExtensions(
+    options.headless ? { mode: "print" } : { mode: "tui", uiContext: ui },
+  );
+  expect(session.getActiveToolNames().sort()).toEqual([...toolNames].sort());
+  const promptStartedAt = performance.now();
+  await session.prompt("Run the scripted fixture workflow.");
+  const finishedAt = performance.now();
+  const entries = session.sessionManager.getEntries();
+  const decisions = entries
+    .filter((entry) => entry.type === "custom" && entry.customType === DECISION_ENTRY_TYPE)
+    .map((entry) => (entry as { data: Record<string, unknown> }).data);
+  const comparisons = entries
+    .filter((entry) => entry.type === "custom" && entry.customType === JEV_RISK_COMPARISON_ENTRY)
+    .map((entry) => (entry as { data: JevRiskComparison }).data);
+  const grants = entries.filter(
+    (entry) => entry.type === "custom" && entry.customType === ALLOW_ENTRY_TYPE,
+  );
+  const toolResults = session.agent.state.messages.filter(
+    (message) => message.role === "toolResult",
+  );
+  return {
+    session,
+    executions,
+    picks,
+    events,
+    decisions,
+    comparisons,
+    grants,
+    toolResults,
+    streams,
+    initializationMs: promptStartedAt - startedAt,
+    workflowMs: finishedAt - promptStartedAt,
+    totalElapsedMs: finishedAt - startedAt,
+  };
+}
+
+beforeEach(() => {
+  state.config = readBundledConfig();
+  vi.stubEnv("SF_GUARDRAIL_JEV_MODE", "off");
