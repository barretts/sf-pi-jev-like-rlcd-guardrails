+    expect(trial.picks).toEqual([["Allow once", "Block"]]);
+    expect(trial.decisions).toMatchObject([{ outcome: "block", risk: { source: "jev" } }]);
+    expect(trial.comparisons).toMatchObject([{ prediction: "abstain", actual: "confirm" }]);
+    expect(trial.toolResults).toMatchObject([{ isError: true }]);
+  });
+  it("executes a confirmed tool exactly once through SDK dispatch and records the model-bound audit", async () => {
+    vi.stubEnv("SF_GUARDRAIL_JEV_MODE", "enforce");
