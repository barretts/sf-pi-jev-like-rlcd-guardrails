+      allowScore: action === "allow" ? 0.999 : 0.01,
+      elapsedMs: 1,
+      inputTokens: 100,
+      inputSha256: createHash("sha256").update(canonical(input)).digest("hex"),
+      calibration: "uncalibrated" as const,
+    })),
+  };
