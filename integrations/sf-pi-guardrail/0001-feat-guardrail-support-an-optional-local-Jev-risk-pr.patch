+export interface JevRiskInput {
+  version: 1;
+  toolName: string;
+  input: Record<string, unknown>;
+  facts: {
+    orgs?: Array<{ type: OrgTypeFilter; guessed: boolean; command?: string }>;
+    browserRef?: {
+      status: "fresh" | "stale" | "missing";
+      label?: string;
