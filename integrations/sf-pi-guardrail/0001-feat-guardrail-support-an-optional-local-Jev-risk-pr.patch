+        errors: trial.toolResults.filter((result) => result.isError).length,
+        initializationMs: trial.initializationMs,
+        workflowMs: trial.workflowMs,
+        totalElapsedMs: trial.totalElapsedMs,
+      });
+      expect(trial.comparisons).toHaveLength(mode === "shadow" ? 2 : 0);
+    }
+    expect(outcomes[1]).toEqual(outcomes[0]);
+    expect(outcomes[0]).toMatchObject({
