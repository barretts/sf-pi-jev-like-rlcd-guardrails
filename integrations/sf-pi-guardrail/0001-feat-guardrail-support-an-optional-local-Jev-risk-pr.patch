+}
+
+const FILE_TOOLS = new Set(["read", "write", "edit", "grep", "find", "ls"]);
+const NATIVE_TOOLS = new Set([
+  "sf_apex",
+  "agentscript_lifecycle",
+  "sf_soql",
+  "slack_canvas",
+  "sf_browser_click",
+  "sf_browser_press",
+  "data360_discover",
+  "data360_connect",
+  "data360_prepare",
+  "data360_harmonize",
+  "data360_segment",
+  "data360_activate",
+  "data360_query",
+  "data360_semantic",
+  "data360_observe",
+  "data360_orchestrate",
+  "data360_api",
