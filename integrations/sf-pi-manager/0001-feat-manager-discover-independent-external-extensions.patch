+    const { pi } = contributions([descriptor({ enabled: true })]);
+
+    const rows = getManagerRows(pi, "/tmp/project", "project", disabledFiles, bundled);
+
+    expect(rows).toHaveLength(3);
+    expect(rows[0]).toMatchObject({ id: "bundled-helper", kind: "bundled", enabled: false });
+    expect(rows[1]).toMatchObject({ id: "bundled-manager", kind: "bundled", enabled: true });
+    expect(rows[2]).toMatchObject({ id: "local-classifier", kind: "external", enabled: true });
+  });
+
+  it("prevents external collisions with a custom bundled registry", () => {
+    const { pi } = contributions([
+      descriptor({ id: bundled[0].id }),
+      descriptor({ id: "independent" }),
+    ]);
+
+    const rows = getManagerRows(pi, "/tmp/project", "global", new Set(), bundled);
+
+    expect(rows.map((row) => row.id)).toEqual(["bundled-helper", "bundled-manager", "independent"]);
+  });
+
+  it("uses the real bundled registry when no override is supplied", () => {
+    const { pi } = contributions([]);
+
+    const rows = getManagerRows(pi, "/tmp/project", "global", new Set());
+
