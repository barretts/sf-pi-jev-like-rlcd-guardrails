diff --git a/extensions/sf-pi-manager/tests/external-extensions.test.ts b/extensions/sf-pi-manager/tests/external-extensions.test.ts
new file mode 100644
index 00000000..74aa6f9a
--- /dev/null
+++ b/extensions/sf-pi-manager/tests/external-extensions.test.ts
@@ -0,0 +1,262 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+import { describe, expect, it, vi } from "vitest";
+import type { SfPiExtension } from "../../../catalog/types.ts";
+import { SF_PI_REGISTRY } from "../../../catalog/registry.ts";
+import { collectExternalExtensions, getManagerRows } from "../lib/external-extensions.ts";
+
+type DiscoveryRequest = {
+  version: number;
+  cwd: string;
+  scope: "global" | "project";
+  extensions: unknown[];
+};
+
+function descriptor(overrides: Record<string, unknown> = {}) {
+  return {
+    id: "local-classifier",
+    name: "Local Classifier",
+    description: "Classify local requests through an independently installed extension.",
+    category: "agent-tool",
+    maturity: "experimental",
+    enabled: true,
+    commands: ["/local-classifier"],
+    tools: ["local_classify"],
+    events: ["session_shutdown"],
+    statusLines: ["Not warmed up"],
+    setEnabled: vi.fn(),
+    ...overrides,
+  };
+}
+
+function discovery(contribute: (request: DiscoveryRequest) => void) {
+  const emit = vi.fn((event: string, request: DiscoveryRequest) => {
+    expect(event).toBe("sf-pi-manager:external-extensions");
+    contribute(request);
+  });
+  return {
+    pi: { events: { emit, on: vi.fn() } } as Parameters<typeof collectExternalExtensions>[0],
+    emit,
+  };
+}
+
+function contributions(extensions: unknown[]) {
+  return discovery((request) => request.extensions.push(...extensions));
+}
+
+describe("external Manager extension discovery", () => {
+  it("collects synchronous cached descriptors without invoking lifecycle or panel callbacks", () => {
+    const getConfigPanel = vi.fn();
+    const entry = descriptor({ getConfigPanel, enabled: false });
+    const { pi, emit } = contributions([entry]);
+
+    const rows = collectExternalExtensions(pi, "/tmp/local-project", "project");
+
+    expect(emit).toHaveBeenCalledOnce();
+    expect(emit.mock.calls[0][1]).toMatchObject({
+      version: 1,
+      cwd: "/tmp/local-project",
+      scope: "project",
+    });
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({
+      id: entry.id,
+      name: entry.name,
+      description: entry.description,
+      category: entry.category,
+      maturity: entry.maturity,
+      enabled: false,
+      kind: "external",
+      defaultEnabled: true,
+      configurable: true,
+      commands: entry.commands,
+      tools: entry.tools,
+      events: entry.events,
+      statusLines: entry.statusLines,
+      getConfigPanel,
+      setEnabled: entry.setEnabled,
+    });
+    expect(getConfigPanel).not.toHaveBeenCalled();
+    expect(entry.setEnabled).not.toHaveBeenCalled();
+  });
+
+  it("marks entries without a panel as non-configurable", () => {
+    const { pi } = contributions([descriptor()]);
+
+    expect(collectExternalExtensions(pi, "/tmp/project", "global")[0]).toMatchObject({
+      kind: "external",
+      configurable: false,
+      defaultEnabled: true,
+    });
+  });
+
+  it("allows legacy APIs without event emission and absent contributors", () => {
+    const oldApi = {} as Parameters<typeof collectExternalExtensions>[0];
+    const withoutEmit = { events: {} } as Parameters<typeof collectExternalExtensions>[0];
+    const { pi } = contributions([]);
+
+    expect(collectExternalExtensions(oldApi, "/tmp/project", "global")).toEqual([]);
+    expect(collectExternalExtensions(withoutEmit, "/tmp/project", "global")).toEqual([]);
+    expect(collectExternalExtensions(pi, "/tmp/project", "global")).toEqual([]);
+  });
+
+  it("passes the current directory and selected settings scope on every discovery", () => {
+    const { pi, emit } = contributions([descriptor()]);
+
+    collectExternalExtensions(pi, "/tmp/first-project", "global");
+    collectExternalExtensions(pi, "/tmp/second-project", "project");
+
+    expect(emit.mock.calls[0][1]).toMatchObject({ cwd: "/tmp/first-project", scope: "global" });
+    expect(emit.mock.calls[1][1]).toMatchObject({ cwd: "/tmp/second-project", scope: "project" });
+  });
+
+  it("rejects malformed descriptors while retaining valid independent contributions", () => {
+    const invalid = [
+      null,
+      "extension",
+      [],
+      descriptor({ id: "" }),
+      descriptor({ name: "" }),
+      descriptor({ description: 42 }),
+      descriptor({ category: "unknown" }),
+      descriptor({ maturity: "preview" }),
+      descriptor({ enabled: "yes" }),
+      descriptor({ commands: [1] }),
+      descriptor({ tools: "local_classify" }),
+      descriptor({ events: [null] }),
+      descriptor({ statusLines: [false] }),
+      descriptor({ getConfigPanel: true }),
+      descriptor({ setEnabled: "toggle" }),
+    ];
+    const { pi } = contributions([...invalid, descriptor({ id: "accepted" })]);
+
+    expect(collectExternalExtensions(pi, "/tmp/project", "project").map((row) => row.id)).toEqual([
+      "accepted",
+    ]);
+  });
+
+  it("accepts each catalog category and documented maturity", () => {
+    const categories = ["manager", "provider", "agent-tool", "safety", "assistive", "ui"];
+    const entries = categories.map((category, index) =>
+      descriptor({
+        id: `external-${index}`,
+        category,
+        maturity: ["stable", "beta", "experimental"][index % 3],
+      }),
+    );
+    const { pi } = contributions(entries);
+
+    expect(
+      collectExternalExtensions(pi, "/tmp/project", "global").map((row) => row.category),
+    ).toEqual(categories);
+  });
+
+  it("rejects bundled ID collisions and retains the first independent descriptor for duplicate IDs", () => {
