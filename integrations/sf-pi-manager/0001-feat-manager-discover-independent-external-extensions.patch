+    const { pi } = contributions([descriptor({ id: SF_PI_REGISTRY[0].id })]);
+
+    expect(collectExternalExtensions(pi, "/tmp/project", "global")).toEqual([]);
+  });
+
+  it("rejects scope keyword IDs that cannot be targeted by Manager commands", () => {
+    const { pi } = contributions([
+      descriptor({ id: "global" }),
+      descriptor({ id: "project" }),
+      descriptor({ id: "local-classifier" }),
+    ]);
+
+    expect(collectExternalExtensions(pi, "/tmp/project", "global").map((row) => row.id)).toEqual([
+      "local-classifier",
+    ]);
+  });
+
+  it("rejects a contribution that changes the protocol version", () => {
+    const { pi } = discovery((request) => {
+      request.version = 2;
+      request.extensions.push(descriptor());
+    });
+
+    expect(collectExternalExtensions(pi, "/tmp/project", "global")).toEqual([]);
+  });
+
