+/* SPDX-License-Identifier: Apache-2.0 */
+/** Versioned, cache-only discovery of independently installed Manager contributions. */
+import type { ExtensionAPI, ExtensionCommandContext } from "@earendil-works/pi-coding-agent";
+import {
+  SF_PI_REGISTRY,
+  type ConfigPanelFactory,
+  type SfPiExtension,
+} from "../../../catalog/registry.ts";
+import type { ManagerScope } from "../../../lib/common/manager-actions.ts";
+
+export const SF_PI_MANAGER_EXTERNAL_EXTENSIONS_EVENT = "sf-pi-manager:external-extensions";
+const MAX_EXTERNAL_EXTENSIONS = 32;
+
+export interface ExternalExtensionDescriptor {
+  id: string;
+  name: string;
+  description: string;
+  category: SfPiExtension["category"];
+  maturity?: SfPiExtension["maturity"];
+  enabled: boolean;
+  commands?: string[];
+  tools?: string[];
+  events?: string[];
+  statusLines?: string[];
+  getConfigPanel?: () => Promise<ConfigPanelFactory>;
+  /** The contributor owns persistence and lifecycle; Manager never writes package filters. */
+  setEnabled?: (
+    enabled: boolean,
+    ctx: ExtensionCommandContext,
+    scope: ManagerScope,
+  ) => Promise<void> | void;
+}
+
+export interface ExternalExtensionsRequest {
+  version: 1;
+  cwd: string;
+  scope: ManagerScope;
+  extensions: ExternalExtensionDescriptor[];
+}
+
+export type BundledExtensionState = SfPiExtension & { kind: "bundled"; enabled: boolean };
+export type ExternalExtensionState = ExternalExtensionDescriptor & {
+  kind: "external";
+  defaultEnabled: true;
+  configurable: boolean;
+  alwaysActive?: false;
+};
+export type ManagerExtensionState = BundledExtensionState | ExternalExtensionState;
+
+export function collectExternalExtensions(
+  pi: Pick<ExtensionAPI, "events">,
+  cwd: string,
+  scope: ManagerScope,
+  bundledIds: readonly string[] = SF_PI_REGISTRY.map((extension) => extension.id),
+): ExternalExtensionState[] {
+  const request: ExternalExtensionsRequest = { version: 1, cwd, scope, extensions: [] };
+  // Older event-bus test doubles and an absent contributor both mean no external rows.
+  if (typeof pi.events?.emit !== "function") return [];
+  try {
+    pi.events.emit(SF_PI_MANAGER_EXTERNAL_EXTENSIONS_EVENT, request);
+  } catch {
+    return [];
+  }
+  if (request.version !== 1 || !Array.isArray(request.extensions)) return [];
+  const usedIds = new Set(bundledIds);
+  const extensions: ExternalExtensionState[] = [];
+  for (const descriptor of request.extensions.slice(0, MAX_EXTERNAL_EXTENSIONS)) {
+    if (!isDescriptor(descriptor) || usedIds.has(descriptor.id)) continue;
+    usedIds.add(descriptor.id);
+    extensions.push({
+      id: descriptor.id,
+      name: descriptor.name,
+      description: descriptor.description,
+      category: descriptor.category,
+      maturity: descriptor.maturity,
+      enabled: descriptor.enabled,
+      commands: descriptor.commands?.slice(),
+      tools: descriptor.tools?.slice(),
+      events: descriptor.events?.slice(),
+      statusLines: descriptor.statusLines?.slice(),
+      getConfigPanel: descriptor.getConfigPanel,
+      setEnabled: descriptor.setEnabled,
+      kind: "external",
+      defaultEnabled: true,
+      configurable: Boolean(descriptor.getConfigPanel),
+    });
+  }
+  return extensions;
+}
+
+export function getManagerRows(
+  pi: Pick<ExtensionAPI, "events">,
+  cwd: string,
+  scope: ManagerScope,
+  disabledFiles: Set<string>,
+  bundled: readonly SfPiExtension[] = SF_PI_REGISTRY,
+): ManagerExtensionState[] {
+  return [
+    ...bundled.map((extension): BundledExtensionState => ({
+      ...extension,
+      kind: "bundled",
+      enabled: Boolean(extension.alwaysActive || !disabledFiles.has(extension.file)),
+    })),
+    ...collectExternalExtensions(
+      pi,
+      cwd,
+      scope,
+      bundled.map((extension) => extension.id),
+    ),
+  ];
+}
+
+function isDescriptor(value: unknown): value is ExternalExtensionDescriptor {
+  if (!value || typeof value !== "object") return false;
+  const descriptor = value as ExternalExtensionDescriptor;
+  return (
+    typeof descriptor.id === "string" &&
+    /^[a-z][a-z0-9-]{0,63}$/.test(descriptor.id) &&
+    !["global", "project"].includes(descriptor.id) &&
+    isText(descriptor.name, 80) &&
+    isText(descriptor.description, 512) &&
+    ["manager", "provider", "agent-tool", "safety", "assistive", "ui"].includes(
+      descriptor.category,
+    ) &&
+    (descriptor.maturity === undefined ||
+      ["stable", "beta", "experimental"].includes(descriptor.maturity)) &&
+    typeof descriptor.enabled === "boolean" &&
+    [descriptor.commands, descriptor.tools, descriptor.events].every(
+      (items) =>
+        items === undefined ||
+        (Array.isArray(items) && items.length <= 64 && items.every((item) => isText(item, 128))),
+    ) &&
+    (descriptor.statusLines === undefined ||
+      (Array.isArray(descriptor.statusLines) &&
+        descriptor.statusLines.length <= 16 &&
+        descriptor.statusLines.every((item) => isText(item, 512)))) &&
+    (descriptor.getConfigPanel === undefined || typeof descriptor.getConfigPanel === "function") &&
+    (descriptor.setEnabled === undefined || typeof descriptor.setEnabled === "function")
+  );
+}
+
+function isText(value: unknown, limit: number): value is string {
+  return (
+    typeof value === "string" &&
+    value.length > 0 &&
+    value.length <= limit &&
+    !/[\x00-\x1f\x7f]/.test(value)
+  );
+}
