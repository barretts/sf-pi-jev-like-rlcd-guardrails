{
  "name": "sf-pi-jev-guardrails",
  "version": "0.3.0",
  "description": "Local C11 semantic risk provider and training tools for SF Guardrail",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barretts/sf-pi-jev-guardrails.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": "./dist/index.js",
    "./extension": "./dist/extension.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "native",
    "training",
    "scripts",
    "models/registry.json",
    "models/current",
    "integrations/sf-pi-guardrail",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "docs/blog-background.md"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:training": "PYTHONPATH=training python3 -m unittest discover -s training/tests -p \"test_*.py\"",
    "native:build": "bash scripts/build-native.sh",
    "train:guardrail": "node scripts/train-guardrail.mjs",
    "export:guardrail": "node scripts/export-guardrail.mjs",
    "verify:guardrail": "node scripts/verify-guardrail.mjs",
    "eval:guardrail": "node scripts/guardrail-diagnostic.mjs --evaluation models/current/diagnostic-evaluation.json",
    "smoke": "node scripts/guardrail-smoke.mjs",
    "test:sf-pi": "node scripts/sf-pi-smoke.mjs",
    "test:package": "node scripts/package-check.mjs --install",
    "format": "prettier --write src tests/*.ts scripts/*.mjs package.json package-lock.json tsconfig.json vitest.config.ts README.md docs/*.md training/README.md integrations/sf-pi-guardrail/README.md THIRD_PARTY_NOTICES.md",
    "format:check": "prettier --check src tests/*.ts scripts/*.mjs package.json package-lock.json tsconfig.json vitest.config.ts README.md docs/*.md training/README.md integrations/sf-pi-guardrail/README.md THIRD_PARTY_NOTICES.md"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
