{
  "name": "simple-jev-ts",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barretts/simple-jev-ts.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "jev": "./dist/cli.js",
    "jev-server": "./dist/server.js"
  },
  "files": [
    "dist",
    "native",
    "rfdt/worker.py",
    "rfdt/requirements.txt",
    "rfdt/requirements.lock",
    "routing/feature_worker.py",
    "fixtures",
    "integrations",
    "scripts",
    "README.md",
    "models/registry.json",
    "VERIFICATION.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:developer-protocol": "node --test tests/developer-*.test.mjs",
    "test:context-protocol": "node --test tests/context-*.test.mjs",
    "test:routing-protocol": "node --test tests/routing-*.test.mjs",
    "eval:context": "node scripts/context-workflow-eval.mjs",
    "eval:routing": "node scripts/routing-workflow-eval.mjs",
    "train:routing": "node scripts/routing-head-train.mjs",
    "eval:routing-head": "node scripts/routing-head-eval.mjs",
    "diagnose:routing-head": "node scripts/routing-head-diagnostic.mjs",
    "native:build": "bash scripts/build-native.sh",
    "agent:build": "bash scripts/build-agent-server.sh",
    "test:live-pi": "node scripts/live-pi.mjs",
    "eval": "node scripts/quality.mjs",
    "model:fetch": "node scripts/fetch-model.mjs",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.json vitest.config.ts README.md VERIFICATION.md models/registry.json",
    "format:check": "prettier --check src tests scripts/*.mjs *.json vitest.config.ts README.md VERIFICATION.md models/registry.json",
    "test:pi": "node scripts/pi-smoke.mjs",
    "test:http": "node scripts/http-smoke.mjs",
    "test:package": "node scripts/package-check.mjs --install"
  },
  "dependencies": {
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.6.0",
    "typebox": "^1.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0 <1.0.0",
    "@earendil-works/pi-tui": ">=0.85.0 <1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "types": "./dist/index.d.ts"
}
