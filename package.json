{
  "name": "simple-jev-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "jev-server": "./dist/server.js"
  },
  "files": [
    "dist",
    "native",
    "scripts",
    "README.md",
    "models/registry.json",
    "VERIFICATION.md"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "native:build": "bash scripts/build-native.sh",
    "model:fetch": "node scripts/fetch-model.mjs",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.json vitest.config.ts README.md VERIFICATION.md models/registry.json",
    "format:check": "prettier --check src tests scripts/*.mjs *.json vitest.config.ts README.md VERIFICATION.md models/registry.json",
    "test:pi": "node scripts/pi-smoke.mjs",
    "test:http": "node scripts/http-smoke.mjs"
  },
  "dependencies": {
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.6.0",
    "typebox": "^1.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0 <1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "types": "./dist/index.d.ts"
}
